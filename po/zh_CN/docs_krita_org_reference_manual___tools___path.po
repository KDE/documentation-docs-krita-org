msgstr "工具"

#: ../../reference_manual/tools/path.rst:11
msgid "Vector"
msgstr "矢量"

#: ../../reference_manual/tools/path.rst:11
msgid "Path"
msgstr "路径"

#: ../../reference_manual/tools/path.rst:11
