msgstr "亮度"

#: ../../reference_manual/dockers/color_sliders.rst:11
msgid "Lightness"
msgstr "亮度"

#: ../../reference_manual/dockers/color_sliders.rst:11
msgid "Intensity"
msgstr "强度"

