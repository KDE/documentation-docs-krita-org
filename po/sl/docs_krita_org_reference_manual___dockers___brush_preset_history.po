#: ../../reference_manual/dockers/brush_preset_history.rst:1
msgid "The Brush Preset History Docker in Krita."
msgstr "Zloženo okno Zgodovina prednastavitev čopiča v Kriti."

#: ../../reference_manual/dockers/brush_preset_history.rst:10
msgid "Brush Preset History"
msgstr "Zgodovina prednastavitev čopiča"

#: ../../reference_manual/dockers/brush_preset_history.rst:10
msgid "Preset"
msgstr "Prednastavitev"

#: ../../reference_manual/dockers/brush_preset_history.rst:15
msgid "Brush Preset History Docker"
msgstr "Zloženo okno Zgodovina prednastavitev čopiča"

#: ../../reference_manual/dockers/brush_preset_history.rst:17
msgid "The brush preset history docker keeps track of the last used presets."
msgstr ""
"Zloženo okno Zgodovine prednastavitev čopiča spremlja zadnje uporabljene "
"prednastavitve."

#: ../../reference_manual/dockers/brush_preset_history.rst:20
msgid "Options"
msgstr "Možnosti"

#: ../../reference_manual/dockers/brush_preset_history.rst:21
msgid "You can access several features when |mouseright| on a preset."
msgstr "Do več funkcij lahko dostopate, če |mouseright| prednastavitev."

#: ../../reference_manual/dockers/brush_preset_history.rst:23
msgid "Forget \"Preset Name\""
msgstr "Pozabi »Ime prednastavitve«"

#: ../../reference_manual/dockers/brush_preset_history.rst:24
msgid "Remove this preset from the list."
msgstr "Odstrani to prednastavitev s seznama."

#: ../../reference_manual/dockers/brush_preset_history.rst:25
msgid "Clear History"
msgstr "Počisti zgodovino"

#: ../../reference_manual/dockers/brush_preset_history.rst:26
msgid "Clears the list."
msgstr "Počisti seznam."

#: ../../reference_manual/dockers/brush_preset_history.rst:28
msgid "Change how the history behaves:"
msgstr "Spremenite način vedenja zgodovine:"

#: ../../reference_manual/dockers/brush_preset_history.rst:30
msgid "Static Position"
msgstr "Statični položaj"

#: ../../reference_manual/dockers/brush_preset_history.rst:31
msgid "All presets keep their positions."
msgstr "Vse prednastavitve obdržijo svoje položaje."

#: ../../reference_manual/dockers/brush_preset_history.rst:32
msgid "Move to Top on Use"
msgstr "Premakni na vrh ob uporabi"

#: ../../reference_manual/dockers/brush_preset_history.rst:33
msgid "Move the last used preset to the top."
msgstr "Premakne zadnjo uporabljeno prednastavitev na vrh."

#: ../../reference_manual/dockers/brush_preset_history.rst:35
msgid "Move presets to the top depending on how often you use them."
msgstr ""
"Premaknite prednastavitve na vrh, odvisno od tega, kako pogosto jih "
"uporabljate."
