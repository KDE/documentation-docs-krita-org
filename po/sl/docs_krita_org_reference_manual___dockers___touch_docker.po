#: ../../reference_manual/dockers/touch_docker.rst:15
msgid "Touch Docker"
msgstr "Sidrišče dotikov"

#: ../../reference_manual/dockers/touch_docker.rst:17
msgid ""
"The Touch Docker is a QML docker with several convenient actions on it. Its "
"purpose is to aid those who use Krita on a touch-enabled screen by providing "
"bigger gui elements."
msgstr ""
"Zloženo okno Dotik je zloženo okno QML z več priročnimi dejanji. Njegov "
"namen je pomagati tistim, ki Krito uporabljajo na zaslonu, ki omogoča dotik, "
"z zagotavljanjem večjih elementov grafičnega uporabniškega vmesnika."

#: ../../reference_manual/dockers/touch_docker.rst:19
msgid "Its actions are..."
msgstr "Njegova dejanja so..."

