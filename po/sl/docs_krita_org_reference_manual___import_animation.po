#: ../../reference_manual/import_animation.rst:1
msgid "Importing video frames."
msgstr "Uvozi sličic videa."

#: ../../reference_manual/import_animation.rst:9
msgid "Animation"
msgstr "Animacija"

#: ../../reference_manual/import_animation.rst:9
msgid "import"
msgstr "uvozi"

#: ../../reference_manual/import_animation.rst:9
