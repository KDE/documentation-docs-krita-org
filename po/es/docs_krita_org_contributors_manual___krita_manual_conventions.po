msgstr "preformatear"

#: ../../contributors_manual/krita_manual_conventions.rst:509
msgid "text by"
msgstr "texto"

#: ../../contributors_manual/krita_manual_conventions.rst:510
msgid "prepending"
msgstr "precediendo"

#: ../../contributors_manual/krita_manual_conventions.rst:511
