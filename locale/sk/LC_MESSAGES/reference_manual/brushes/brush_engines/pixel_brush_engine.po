msgid "Pixel Brush Engine"
msgstr "Pixel Brush Engine"

#: ../../reference_manual/brushes/brush_engines/pixel_brush_engine.rst:11
msgid "Brush Engine"
msgstr "Engine štetca"

#: ../../reference_manual/brushes/brush_engines/pixel_brush_engine.rst:19
