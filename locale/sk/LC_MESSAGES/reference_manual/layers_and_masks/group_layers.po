msgstr "Ako používať skupinové vrstvy v Krite."

#: ../../reference_manual/layers_and_masks/group_layers.rst:12
msgid "Layers"
msgstr "Vrstvy"

#: ../../reference_manual/layers_and_masks/group_layers.rst:12
