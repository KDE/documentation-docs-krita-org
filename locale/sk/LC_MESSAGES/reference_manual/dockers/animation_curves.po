msgstr "|mouseleft| :kbd:`+ drag` : *Presunúť* snímku/snímky."

#: ../../reference_manual/dockers/animation_curves.rst:132
msgid "|mouseleft| double-click : Select all keyframes at time."
msgstr "|mouseleft| dvojité kliknutie: Vybrať všetky kľúčové snímky v čase."

#: ../../reference_manual/dockers/animation_curves.rst:133
msgid ""
":kbd:`Alt +` |mouseleft| double-click : Select all keyframes of channel."
msgstr ""
":kbd:`Alt +` |mouseleft| dvojité kliknutie: Vybrať všetky kľúčové snímky "
"kanála."

#: ../../reference_manual/dockers/animation_curves.rst:134
