msgid "Small Color Selector"
msgstr "Malý výber farby"

#: ../../reference_manual/dockers/small_color_selector.rst:11
msgid "Color"
msgstr "Farba"

#: ../../reference_manual/dockers/small_color_selector.rst:11
msgid "Color Selector"
msgstr "Výber farby"

#: ../../reference_manual/dockers/small_color_selector.rst:19
