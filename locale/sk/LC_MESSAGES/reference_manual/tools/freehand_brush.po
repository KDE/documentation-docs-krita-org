#: ../../<rst_epilog>:18
msgid "toolfreehandbrush"
msgstr "Nástroj štetca voľnou rukou"

#: ../../<rst_epilog>:18
msgid ".. image:: /images/icons/freehand_brush_tool.svg"
msgstr ""
".. image:: images/icons/freehand_brush_tool.svg\n"
