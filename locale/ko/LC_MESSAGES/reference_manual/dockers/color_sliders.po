#: ../../reference_manual/dockers/color_sliders.rst:16
msgid "Color Sliders"
msgstr "색상 슬라이더"

#: ../../reference_manual/dockers/color_sliders.rst:11
msgid "Color"
msgstr "색상"

#: ../../reference_manual/dockers/color_sliders.rst:11
msgid "Color Selector"
msgstr "색상 선택기"

#: ../../reference_manual/dockers/color_sliders.rst:11
msgid "Hue"
msgstr "색조"

#: ../../reference_manual/dockers/color_sliders.rst:11
msgid "Saturation"
msgstr "채도"

#: ../../reference_manual/dockers/color_sliders.rst:11
msgid "Value"
msgstr "명도"

#: ../../reference_manual/dockers/color_sliders.rst:11
msgid "Brightness"
msgstr "휘도"

#: ../../reference_manual/dockers/color_sliders.rst:11
msgid "Lightness"
msgstr "밝기"

#: ../../reference_manual/dockers/color_sliders.rst:11
msgid "Intensity"
msgstr "명암"

#: ../../reference_manual/dockers/color_sliders.rst:11
msgid "Luma"
msgstr "루마"

#: ../../reference_manual/dockers/color_sliders.rst:11
msgid "Luminosity"
msgstr "광도"

