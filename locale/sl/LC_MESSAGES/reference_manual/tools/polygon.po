#: ../../reference_manual/tools/polygon.rst:1
msgid "Krita's polygon tool reference."
msgstr "Podrobnosti o Kritinem orodju za risanje mnogokotnikov."

#: ../../reference_manual/tools/polygon.rst:10
msgid "Tools"
msgstr "Orodja"

#: ../../reference_manual/tools/polygon.rst:10
msgid "Polygon"
msgstr "Mnogokotnik"

#: ../../reference_manual/tools/polygon.rst:15
msgid "Polygon Tool"
msgstr "Orodje Mnogokotnik"

#: ../../reference_manual/tools/polygon.rst:17
msgid "|toolpolygon|"
msgstr "|toolpolygon|"

#: ../../reference_manual/tools/polygon.rst:19
msgid ""
"With this tool you can draw polygons. Click the |mouseleft| to indicate the "
"starting point and successive vertices, then double-click or press the :kbd:"
"`Enter` key to connect the last vertex to the starting point."
msgstr ""
"S tem orodjem lahko narišete mnogokotnike. Kliknite |mouseleft|, če želite "
"navesti izhodišče in zaporedna oglišča, nato dvokliknite ali pritisnite :kbd:"
"`vnašalko`, da povežete zadnje oglišče z izhodiščem."

#: ../../reference_manual/tools/polygon.rst:21
msgid ":kbd:`Shift + Z` undoes the last clicked point."
msgstr ":kbd:`Dvigalka + Z` razveljavi zadnjo kliknjeno točko."

#: ../../reference_manual/tools/polygon.rst:25
msgid "|mouseright| wills also undo the last added point."
msgstr "|mouseright| razveljavi tudi zadnjo dodano točko."

#: ../../reference_manual/tools/polygon.rst:28
msgid "Tool Options"
msgstr "Možnosti orodja"
