#: ../../reference_manual/blending_modes/arithmetic.rst:162
msgid "Subtract"
msgstr "Odvzemi"

#: ../../reference_manual/blending_modes/arithmetic.rst:166
msgid "This blending mode is called \"Subtract\" in English."
msgstr "Ta način mešanja se v imenuje »Odštej« (angl. »Subtract«)."

#: ../../reference_manual/blending_modes/arithmetic.rst:168
msgid "Subtracts the top layer from the bottom layer."
msgstr "Od spodnje plasti odšteje zgornjo plast."

#: ../../reference_manual/blending_modes/arithmetic.rst:170
msgid "White(1, 1, 1)_White(1, 1, 1) = Black(0, 0, 0)"
msgstr "Bela(1, 1, 1)_Bela(1, 1, 1) = Črna(0, 0, 0)"

#: ../../reference_manual/blending_modes/arithmetic.rst:172
msgid "White(1, 1, 1)_Gray(0.5, 0.5, 0.5) = Gray(0.5, 0.5, 0.5)"
msgstr "Bela(1, 1, 1)_Siva(0,5, 0,5, 0,5) = Siva(0,5, 0,5, 0,5)"

#: ../../reference_manual/blending_modes/arithmetic.rst:174
msgid ""
"Darker Gray(0.4, 0.4, 0.4)_Lighter Gray(0.5, 0.5, 0.5) = (-0.1, -0.1, -0.1) "
"→ Black(0, 0, 0)"
msgstr ""
"Temnejša siva(0,4, 0,4, 0,4)_Svetlejša siva (0,5, 0,5, 0,5) = (-0,1, -0,1, "
"-0,1) → Črna(0, 0, 0)"

