#: ../../reference_manual/blending_modes/arithmetic.rst:95
msgid "Inverse Subtract"
msgstr "Inverzno odštej"

#: ../../reference_manual/blending_modes/arithmetic.rst:99
#, fuzzy
msgid "This blending mode is called \"Inverse Subtract\" in English."
msgstr "Ta način mešanja se v angleščini imenuje \"Inverse Subtract\"."

#: ../../reference_manual/blending_modes/arithmetic.rst:101
#, fuzzy
msgid ""
"This inverts the lower layer before subtracting it from the upper layer."
msgstr "S tem se spodnja plast obrni, preden jo odšteje od zgornje plasti."

#: ../../reference_manual/blending_modes/arithmetic.rst:103
msgid ""
"Lighter Gray(0.5, 0.5, 0.5)_(1_Darker Gray(0.4, 0.4, 0.4)) = (-0.1, -0.1, "
"-0.1) → Black(0, 0, 0)"
msgstr ""
"Svetlejša siva(0,5, 0,5, 0,5)_(1_Temnejša siva(0,4, 0,4, 0,4)) = (-0,1, "
"-0,1, -0,1) → Črna(0, 0, 0)"

