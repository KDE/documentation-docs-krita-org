#: ../../reference_manual/hdr_display.rst:10
msgid "HDR"
msgstr "HDR"

#: ../../reference_manual/hdr_display.rst:10
#, fuzzy
msgid "High Dynamic Range"
msgstr "HDR (visoko dinamični razpon, angl. High Dynamic-Range)"

#: ../../reference_manual/hdr_display.rst:10
