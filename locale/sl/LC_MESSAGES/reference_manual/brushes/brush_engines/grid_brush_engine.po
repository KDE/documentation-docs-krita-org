#: ../../reference_manual/brushes/brush_engines/grid_brush_engine.rst:86
msgid "Sample Input Layer"
msgstr "Vzorčna vhodna plast"

#: ../../reference_manual/brushes/brush_engines/grid_brush_engine.rst:87
#, fuzzy
msgid ""
