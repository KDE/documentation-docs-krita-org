#: ../../reference_manual/resource_management.rst:157
msgid "Tags"
msgstr "タグ"

#: ../../reference_manual/resource_management.rst:159
#, fuzzy
#| msgid ""
#| "Krita also has a robust tagging system for you to manage the resources on "
#| "the fly while painting. All Krita resources can be tagged. These tags can "
#| "be added via the resource manager, but also via the respective dockers "
