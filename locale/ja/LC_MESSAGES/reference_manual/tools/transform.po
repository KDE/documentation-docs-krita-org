msgid "Krita's transform tool reference."
msgstr "Krita 変形ツールの説明。"

#: ../../reference_manual/tools/transform.rst:13
#: ../../reference_manual/tools/transform.rst:57
msgid "Warp"
msgstr "格子点"

#: ../../reference_manual/tools/transform.rst:13
#: ../../reference_manual/tools/transform.rst:82
msgid "Cage"
msgstr "ケージ"

#: ../../reference_manual/tools/transform.rst:13
