msgstr "左: **通常**. 右: **焼き込み(リニア)**."

#: ../../reference_manual/blending_modes/darken.rst:183
msgid ""
"[Light Blue(0.1608, 0.6274, 0.8274) + Orange(1, 0.5961, 0.0706)]_1 = "
"(0.1608, 0.2235, -0.1020) → Dark Green(0.1608, 0.2235, 0)"
msgstr ""
"[ライトブルー(0.1608, 0.6274, 0.8274) + オレンジ(1, 0.5961, 0.0706)]_1 = "
"(0.1608, 0.2235, -0.1020) → ダークグリーン(0.1608, 0.2235, 0)"

