msgid "Flat Light"
msgstr "フラットライト"

#: ../../reference_manual/blending_modes/lighten.rst:134
msgid ""
"The spreadout variation of Vivid Light mode which range is between 0.0f and "
"1.0f."
msgstr "範囲0.0fから1.0fの、ビビッドライトモードの派生です。"

