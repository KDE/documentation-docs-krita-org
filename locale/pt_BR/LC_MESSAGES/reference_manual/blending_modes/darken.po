msgid "Linear Burn"
msgstr "Queima linear"

#: ../../reference_manual/blending_modes/darken.rst:172
msgid "This blending mode is called \"Linear Burn\" in English."
msgstr "Este modo de mesclagem é chamado de \"Linear Burn\" em inglês."

#: ../../reference_manual/blending_modes/darken.rst:174
msgid ""
"Adds the values of the two layers together and then subtracts 1. Seems to "
"produce the same result as :ref:`bm_inverse_subtract`."
msgstr ""
"Soma os valores das duas camadas e depois subtrai 1. Parece produzir o mesmo "
"resultado que :ref:`bm_inverse_subtract`."

#: ../../reference_manual/blending_modes/darken.rst:176
msgid ""
"[Darker Gray(0.4, 0.4, 0.4) + Lighter Gray(0.5, 0.5, 0.5)]_1 = (-0.1000, "
"-0.1000, -0.1000)  → Black(0, 0, 0)"
msgstr ""
"[Cinza mais escuro(0.4, 0.4, 0.4) + Cinza mais claro(0.5, 0.5, 0.5)]_1 = "
"(-0.1000, -0.1000, -0.1000)  → Black(0, 0, 0)"

