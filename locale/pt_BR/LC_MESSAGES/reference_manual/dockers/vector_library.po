msgid "Symbol Libraries"
msgstr "Bibliotecas de símbolos"

#: ../../reference_manual/dockers/vector_library.rst:10
msgid "Vector Library"
msgstr "Biblioteca de vetor"

#: ../../reference_manual/dockers/vector_library.rst:10
msgid "Symbol Library"
msgstr "Biblioteca de símbolo"

#: ../../reference_manual/dockers/vector_library.rst:10
msgid "SVG Symbols"
