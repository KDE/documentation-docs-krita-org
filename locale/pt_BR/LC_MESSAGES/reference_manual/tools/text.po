#: ../../reference_manual/tools/text.rst:-1
msgid ""
"A curved path, outlined in red, with a cursor over it. The cursor shape has "
"changed to a \"T\" standing on a curve."
msgstr ""
"Um caminho curvo, delineado em vermelho, com um cursor sobre ele. O formato "
"do cursor mudou para um \"T\" posicionado sobre uma curva."

#: ../../reference_manual/tools/text.rst:-1
