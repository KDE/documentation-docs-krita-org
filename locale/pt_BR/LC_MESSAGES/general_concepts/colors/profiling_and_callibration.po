#: ../../general_concepts/colors/profiling_and_callibration.rst:-1
msgid "Color Models in Krita"
msgstr "Modelos de cor no Krita"

#: ../../general_concepts/colors/profiling_and_callibration.rst:13
msgid "Color"
msgstr "Cor"

#: ../../general_concepts/colors/profiling_and_callibration.rst:13
msgid "Profiling"
msgstr "Perfil"

#: ../../general_concepts/colors/profiling_and_callibration.rst:13
msgid "Calibration"
