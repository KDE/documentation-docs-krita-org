msgid "\\*.heic"
msgstr "\\*.heic"

#: ../../general_concepts/file_formats/file_heif.rst:10
msgid "hdr"
msgstr "HDR"

#: ../../general_concepts/file_formats/file_heif.rst:10
msgid "AVIF"
msgstr "AVIF"

#: ../../general_concepts/file_formats/file_heif.rst:10
