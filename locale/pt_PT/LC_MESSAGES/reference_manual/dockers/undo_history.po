msgid "Overview of the undo history docker."
msgstr "Introdução à área acoplável do histórico de anulações."

#: ../../reference_manual/dockers/undo_history.rst:12
msgid "Undo"
msgstr "Desfazer"

#: ../../reference_manual/dockers/undo_history.rst:12
msgid "Redo"
msgstr "Refazer"

