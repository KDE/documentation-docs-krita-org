msgid "How to use clone layers."
msgstr "Como usar as camadas de clonagem."

#: ../../reference_manual/layers_and_masks/clone_layers.rst:15
msgid "Layers"
msgstr "Camadas"

#: ../../reference_manual/layers_and_masks/clone_layers.rst:15
msgid "Linked Clone"
msgstr "Clone Ligado"

#: ../../reference_manual/layers_and_masks/clone_layers.rst:15
