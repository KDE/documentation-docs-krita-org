#: ../../reference_manual/tools/freehand_select.rst:1
msgid "Krita's Freehand Selection tool reference."
msgstr ""

#: ../../reference_manual/tools/freehand_select.rst:14
msgid "Tools"
msgstr "Ferramentas"

#: ../../reference_manual/tools/freehand_select.rst:14
msgid "Selection"
msgstr "Selecção"

#: ../../reference_manual/tools/freehand_select.rst:14
msgid "Freehand"
msgstr "Caminho Livre à Mão"

#: ../../reference_manual/tools/freehand_select.rst:14
msgid "Outline Select"
msgstr "Selecção pelo Contorno"

#: ../../reference_manual/tools/freehand_select.rst:19
msgid "Freehand Selection Tool"
msgstr "Ferramenta de Selecção Livre"

#: ../../reference_manual/tools/freehand_select.rst:21
msgid "|toolselectfreehand|"
msgstr ""

#: ../../reference_manual/tools/freehand_select.rst:23
msgid "Make :ref:`selections_basics` by freely drawing the selection outline around the canvas. Click and drag to draw a border around the section you wish to select."
msgstr ""

#: ../../reference_manual/tools/freehand_select.rst:27
msgid "This tool was previously called as the Outline Selection tool. Starting from Krita 4.4.2 release it has been renamed to Freehand Selection Tool. Most of the behavior of the Freehand Selection Tool is common to all other selection tools, please make sure to read :ref:`selections_basics` to learn more about this tool."
msgstr ""

#: ../../reference_manual/tools/freehand_select.rst:32
msgid "Hotkeys and Sticky keys"
msgstr "Atalhos e Teclas Fixas"

#: ../../reference_manual/tools/freehand_select.rst:34
msgid ":kbd:`R` sets the selection to 'replace' in the tool options, this is the default mode."
msgstr ":kbd:`R` configura a selecção para `substituição` nas opções da ferramenta; este é o modo por omissão."

#: ../../reference_manual/tools/freehand_select.rst:35
msgid ":kbd:`A` sets the selection to 'add' in the tool options."
msgstr ":kbd:`A` configura a selecção como `adição` nas opções da ferramenta."

#: ../../reference_manual/tools/freehand_select.rst:36
msgid ":kbd:`S` sets the selection to 'subtract' in the tool options."
msgstr ":kbd:`S` configura a selecção para `subtracção` nas opções da ferramenta."

#: ../../reference_manual/tools/freehand_select.rst:37
msgid ":kbd:`Shift +` |mouseleft| sets the subsequent selection to 'add'. You can release the :kbd:`Shift` key while dragging, but it will still be set to 'add'. Same for the others."
msgstr ":kbd:`Shift` + |mouseleft| configura a selecção subsequente para `adição`. Poderá largar a tecla :kbd:`Shift` enquanto arrasta, mas continuará à mesma no modo de 'adição'. O mesmo se aplica aos outros."

#: ../../reference_manual/tools/freehand_select.rst:38
msgid ":kbd:`Alt +` |mouseleft| sets the subsequent selection to 'subtract'."
msgstr ":kbd:`Alt` + |mouseleft| configura a selecção subsequente como `subtracção`."

#: ../../reference_manual/tools/freehand_select.rst:39
msgid ":kbd:`Ctrl +` |mouseleft| sets the subsequent selection to 'replace'."
msgstr ":kbd:`Ctrl` + |mouseleft| configura a selecção subsequente como `substituição`."

#: ../../reference_manual/tools/freehand_select.rst:40
msgid ":kbd:`Shift + Alt +` |mouseleft| sets the subsequent selection to 'intersect'."
msgstr ":kbd:`Shift + Alt` + |mouseleft| configura a selecção subsequente como `intersecção`."

#: ../../reference_manual/tools/freehand_select.rst:41
msgid "Holding the :kbd:`Ctrl` key while drawing the selection temporarily makes this tool behave like the Polygon Selection tool and you can then draw straight line selections by just clicking on the canvas."
msgstr ""

#: ../../reference_manual/tools/freehand_select.rst:45
msgid "Hovering your cursor over the dashed line of the selection, or marching ants as it is commonly called turns the cursor into the move tool icon, which you |mouseleft| and drag to move the selection."
msgstr ""

#: ../../reference_manual/tools/freehand_select.rst:46
msgid "|mouseright| will open up a selection quick menu with amongst others the ability to edit the selection."
msgstr "Se usar o |mouseright|, irá abrir um menu de selecção rápida que, entre outras coisas, terá a possibilitar de editar a selecção."

#: ../../reference_manual/tools/freehand_select.rst:54
msgid "You can switch the behavior of the :kbd:`Alt` key to use :kbd:`Ctrl` instead by toggling the switch in Tool Settings in the :ref:`general_settings`"
msgstr "Poderá mudar o comportamento da tecla :kbd:`Alt` para usar como alternativa o :kbd:`Ctrl`, comutando o interruptor na Configuração da Ferramenta em :ref:`general_settings`"

#: ../../reference_manual/tools/freehand_select.rst:58
msgid "This tool is not bound to any Hotkey, if you want to define one, go to :menuselection:`Settings --> Configure Krita --> Keyboard Shortcuts` and search for 'Freehand Selection Tool', there you can select the shortcut you want. Check :ref:`shortcut_settings` for more info."
msgstr ""

#: ../../reference_manual/tools/freehand_select.rst:62
msgid "Tool Options"
msgstr "Opções da Ferramenta"

#: ../../reference_manual/tools/freehand_select.rst:67
msgid "Mode"
msgstr "Modo"

#: ../../reference_manual/tools/freehand_select.rst:68
#: ../../reference_manual/tools/freehand_select.rst:70
msgid "This option is explained in the :ref:`pixel_vector_selection` section."
msgstr "Esta opção está explicada na secção :ref:`pixel_vector_selection`."

#: ../../reference_manual/tools/freehand_select.rst:69
msgid "Action"
msgstr "Acção"

#: ../../reference_manual/tools/freehand_select.rst:72
msgid "Anti-aliasing"
msgstr "Suavização"

#: ../../reference_manual/tools/freehand_select.rst:72
msgid "This toggles whether or not to give selections feathered edges. Some people prefer hard-jagged edges for their selections."
msgstr "Isto indica se são usados contornos leves nas selecções. Algumas pessoas preferem arestas vincadas para as suas selecções."

#: ../../reference_manual/tools/freehand_select.rst:76
msgid "Anti-aliasing is only available on Pixel Selection Mode."
msgstr "A suavização só está disponível no Modo de Selecção em Pixels."
