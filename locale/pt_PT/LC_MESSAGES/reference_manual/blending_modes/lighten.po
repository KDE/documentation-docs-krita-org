#: ../../reference_manual/blending_modes/lighten.rst:168
msgid "This blending mode is called \"Flat Light\" in English."
msgstr ""

#: ../../reference_manual/blending_modes/lighten.rst:170
msgid ""
"The spreadout variation of Vivid Light mode which range is between 0.0f and "
"1.0f."
msgstr ""
"A variação da dispersão do modo de Luz Viva, cujo intervalo está entre 0,0f "
"e 1,0f."

