"Blending_modes_Copy_Red_Sample_image_with_dots.png"

#: ../../reference_manual/blending_modes/misc.rst:88
msgid "Left: **Normal**. Right: **Copy Red**."
msgstr "Esquerda: **Normal**. Direita: **Copiar o Vermelho**."

