#: ../../reference_manual/blending_modes/quadratic.rst:140
msgid "Reflect"
msgstr "Reflexão"

#: ../../reference_manual/blending_modes/quadratic.rst:144
msgid "This blending mode is called \"Reflect\" in English."
msgstr "Este modo de mistura chama-se \"Reflect\" em Inglês."

#: ../../reference_manual/blending_modes/quadratic.rst:146
msgid ""
"Reflect is essentially the Color Dodge blending mode with quadratic falloff."
msgstr ""
"A Reflexão é essencialmente o modo de mistura por Desvio de Cores com um "
"decaimento quadrático."

