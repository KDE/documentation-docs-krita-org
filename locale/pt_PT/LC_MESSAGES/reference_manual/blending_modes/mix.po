#: ../../reference_manual/blending_modes/mix.rst:103
msgid "Behind"
msgstr "Atrás"

#: ../../reference_manual/blending_modes/mix.rst:107
msgid "This blending mode is called \"Behind\" in English."
msgstr "Este modo de mistura chama-se \"Behind\" em Inglês."

#: ../../reference_manual/blending_modes/mix.rst:109
msgid ""
"Does the opposite of Normal, and tries to have the upper layer rendered "
"below the lower layer."
msgstr ""
"Faz o oposto do Normal e tentar ter a camada superior desenhada atrás da "
"camada actual."

