msgstr "Adiciona uma nova camada de pintura."

#: ../../reference_manual/main_menu/layers_menu.rst:32
msgid "New layer from visible"
msgstr "Nova camada da visível"

#: ../../reference_manual/main_menu/layers_menu.rst:33
