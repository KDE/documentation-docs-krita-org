msgstr "Adiciona a nova selecção à selecção actual."

#: ../../user_manual/selections.rst:57
msgid "Subtract"
msgstr "Subtrair"

#: ../../user_manual/selections.rst:57
msgid "Alt"
msgstr "Alt"

