#: ../../reference_manual/blending_modes/arithmetic.rst:42
msgid "Red(1, 0, 0) + Gray(0.5, 0.5, 0.5) = Pink(1, 0.5, 0.5)"
msgstr "Rojo(1, 0, 0) + Gris(0.5, 0.5, 0.5) = Rosa(1, 0.5, 0.5)"

