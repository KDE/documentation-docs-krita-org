msgstr "Il formato di file EXR come esportato da Krita."

#: ../../general_concepts/file_formats/file_exr.rst:10
msgid "*.exr"
msgstr "*.exr"

#: ../../general_concepts/file_formats/file_exr.rst:10
msgid "EXR"
msgstr "EXR"

#: ../../general_concepts/file_formats/file_exr.rst:10
msgid "HDR Fileformat"
msgstr "Formato di file HDR"

#: ../../general_concepts/file_formats/file_exr.rst:10
