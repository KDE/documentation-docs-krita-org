#: ../../general_concepts/file_formats/file_jxl.rst:-1
msgid "The JPEG XL file format in Krita."
msgstr "Il formato di file JPEG XL in Krita."

#: ../../general_concepts/file_formats/file_jxl.rst:12
msgid "*.jxl"
msgstr "*.jxl"

#: ../../general_concepts/file_formats/file_jxl.rst:12
msgid "JPEG XL"
msgstr "JPEG XL"

#: ../../general_concepts/file_formats/file_jxl.rst:12
msgid "JPEG-XL"
msgstr "JPEG-XL"

#: ../../general_concepts/file_formats/file_jxl.rst:12
msgid "JPEGXL"
msgstr "JPEGXL"

#: ../../general_concepts/file_formats/file_jxl.rst:12
