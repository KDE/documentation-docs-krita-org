#: ../../reference_manual/preferences/canvas_input_settings.rst:-1
msgid "Canvas input settings in Krita."
msgstr "Impostazioni dell'inserimento su tela in Krita."

#: ../../reference_manual/preferences/canvas_input_settings.rst:11
#: ../../reference_manual/preferences/canvas_input_settings.rst:16
msgid "Canvas Input Settings"
msgstr "Impostazioni dell'inserimento su tela"

#: ../../reference_manual/preferences/canvas_input_settings.rst:11
msgid "Preferences"
msgstr "Preferenze"

#: ../../reference_manual/preferences/canvas_input_settings.rst:11
msgid "Settings"
msgstr "Impostazioni"

#: ../../reference_manual/preferences/canvas_input_settings.rst:11
msgid "Tablet"
msgstr "Tavoletta grafica"

#: ../../reference_manual/preferences/canvas_input_settings.rst:18
msgid ""
"Krita has ways to set mouse and keyboard combinations for different actions. "
"The user can set which combinations to use for a certain Krita command over "
"here. This section is under development and will include more options in "
"future."
msgstr ""
"Krita possiede due modi per impostare le combinazioni di mouse e tastiera "
"per azioni differenti. L'utente può impostare qui quale combinazione "
"utilizzare su un determinato comando di Krita. Questa sezione è sotto "
"sviluppo e includerà altre opzioni in futuro."

#: ../../reference_manual/preferences/canvas_input_settings.rst:21
msgid "Profile"
msgstr "Profilo"

#: ../../reference_manual/preferences/canvas_input_settings.rst:21
msgid "The user can make different profiles of combinations and save them."
msgstr "L'utente può creare diversi profili di combinazioni e salvarli."

#: ../../reference_manual/preferences/canvas_input_settings.rst:25
msgid ""
"Same as Activate, but with the tool treating the foreground and background "
"colors as if they were flipped."
msgstr ""
"Uguale ad Attiva, ma lo strumento che tratta i colori di sfondo e primo "
"piano come se fossero scambiati."

#: ../../reference_manual/preferences/canvas_input_settings.rst:26
msgid "Tool Invocation"
msgstr "Richiamo dello strumento"

#: ../../reference_manual/preferences/canvas_input_settings.rst:26
msgid "Activate with Other Color"
msgstr "Attiva con altro colore"

