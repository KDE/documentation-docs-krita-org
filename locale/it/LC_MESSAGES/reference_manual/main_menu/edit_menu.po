#: ../../reference_manual/main_menu/edit_menu.rst:1
msgid "The edit menu in Krita."
msgstr "Il menu Modifica in Krita."

#: ../../reference_manual/main_menu/edit_menu.rst:11
#: ../../reference_manual/main_menu/edit_menu.rst:19
msgid "Undo"
msgstr "Annulla"

#: ../../reference_manual/main_menu/edit_menu.rst:11
#: ../../reference_manual/main_menu/edit_menu.rst:22
msgid "Redo"
msgstr "Rifai"

#: ../../reference_manual/main_menu/edit_menu.rst:11
#: ../../reference_manual/main_menu/edit_menu.rst:25
msgid "Cut"
msgstr "Taglia"

#: ../../reference_manual/main_menu/edit_menu.rst:11
#: ../../reference_manual/main_menu/edit_menu.rst:28
msgid "Copy"
msgstr "Copia"

#: ../../reference_manual/main_menu/edit_menu.rst:11
#: ../../reference_manual/main_menu/edit_menu.rst:40
msgid "Paste"
msgstr "Incolla"

#: ../../reference_manual/main_menu/edit_menu.rst:11
msgid "Edit"
msgstr "Modifica"

#: ../../reference_manual/main_menu/edit_menu.rst:16
msgid "Edit Menu"
msgstr "Menu Modifica"

#: ../../reference_manual/main_menu/edit_menu.rst:21
msgid "Undoes the last action. Shortcut: :kbd:`Ctrl + Z`"
msgstr "Annulla l'ultima operazione. Scorciatoia: :kbd:`Ctrl + Z`"

#: ../../reference_manual/main_menu/edit_menu.rst:24
msgid "Redoes the last undone action. Shortcut: :kbd:`Ctrl + Shift+ Z`"
msgstr ""
"Rifà l'ultima operazione annullata. Scorciatoia: :kbd:`Ctrl + Maiusc + Z`"

#: ../../reference_manual/main_menu/edit_menu.rst:27
msgid "Cuts the selection or layer. Shortcut: :kbd:`Ctrl + X`"
msgstr "Taglia la selezione o il livello. Scorciatoia: :kbd:`Ctrl + X`"

#: ../../reference_manual/main_menu/edit_menu.rst:30
msgid "Copies the selection or layer. Shortcut: :kbd:`Ctrl + C`"
msgstr "Copia la selezione o il livello. Scorciatoia: :kbd:`Ctrl + C`"

#: ../../reference_manual/main_menu/edit_menu.rst:31
msgid "Cut (Sharp)"
msgstr "Taglia (nitido)"

#: ../../reference_manual/main_menu/edit_menu.rst:33
msgid "This prevents semi-transparent areas from appearing on your cut pixels, making them either fully opaque or fully transparent."
msgstr ""
"Impedisce alle aree semi-trasparenti di apparire nei pixel tagliati, "
"rendendoli o interamente opachi o interamente trasparenti."

#: ../../reference_manual/main_menu/edit_menu.rst:34
msgid "Copy (Sharp)"
msgstr "Copia (nitido)"

#: ../../reference_manual/main_menu/edit_menu.rst:36
msgid "Same as :term:`Cut (Sharp)` but then copying instead."
msgstr "Uguale :term:`Taglia (nitido)` ma con funzione di copia."

#: ../../reference_manual/main_menu/edit_menu.rst:37
msgid "Copy Merged"
msgstr "Copia fuso"

#: ../../reference_manual/main_menu/edit_menu.rst:39
msgid "Copies the selection over all layers. Shortcut: :kbd:`Ctrl + Shift + C`"
msgstr ""
"Copia la selezione su tutti i livelli. Scorciatoia: :kbd:`Ctrl + Maiusc + C`"

#: ../../reference_manual/main_menu/edit_menu.rst:42
msgid "Pastes the copied buffer into the image as a new layer. Shortcut: :kbd:`Ctrl + V`"
msgstr ""
"Incolla il buffer copiato nell'immagine come nuovo livello. Scorciatoia: "
":kbd:`Ctrl + V`"

#: ../../reference_manual/main_menu/edit_menu.rst:43
msgid "Paste at Cursor"
msgstr "Incolla al cursore"

#: ../../reference_manual/main_menu/edit_menu.rst:45
msgid "Same as :term:`Paste`, but aligns the image to the cursor. Shortcut: :kbd:`Ctrl + Alt + V`"
msgstr ""
"Uguale a :term:`Incolla`, ma allinea l'immagine al cursore. Scorciatoia: "
":kbd:`Ctrl + Alt + V`"

#: ../../reference_manual/main_menu/edit_menu.rst:46
msgid "Paste into Active Layer"
msgstr "Incolla nel livello attivo"

#: ../../reference_manual/main_menu/edit_menu.rst:48
msgid "Pastes the copied buffer into the current layer as a new selection."
msgstr "Incolla il buffer copiato nel livello attuale come nuova selezione."

#: ../../reference_manual/main_menu/edit_menu.rst:51
msgid "Paste into New Image"
msgstr "Incolla in una nuova immagine"

#: ../../reference_manual/main_menu/edit_menu.rst:53
msgid "Pastes the copied buffer into a new image. Shortcut: :kbd:`Ctrl + Shift + N`"
msgstr ""
"Incolla il buffer copiato in una nuova immagine. Scorciatoia: :kbd:`Ctrl + "
"Maiusc + N`"

#: ../../reference_manual/main_menu/edit_menu.rst:54
msgid "Paste as Reference Image"
msgstr "Incolla come immagine di riferimento"

#: ../../reference_manual/main_menu/edit_menu.rst:56
msgid "Pastes the selection as a new :ref:`Reference Image <reference_images_tool>`."
msgstr ""
"Incolla la selezione come una nuova :ref:`immagine di riferimento "
"<reference_images_tool>`."

#: ../../reference_manual/main_menu/edit_menu.rst:57
msgid "Paste Shape Style"
msgstr "Incolla stile della forma"

#: ../../reference_manual/main_menu/edit_menu.rst:59
msgid "Used with :ref:`shape_selection_tool`, this allows you to copy the style (the fill, outline and markers) of one vector shape to another."
msgstr ""
"Utilizzato con lo :ref:`shape_selection_tool`, ti permette di copiare lo "
"stile (riempimento, contorno e marcatori) di una forma vettoriale in "
"un'altra."

#: ../../reference_manual/main_menu/edit_menu.rst:62
msgid "Clear"
msgstr "Pulisci"

#: ../../reference_manual/main_menu/edit_menu.rst:64
msgid "Empty the currently selected area or layer. Shortcut: :kbd:`Del`"
msgstr ""
"Svuota l'area o livello correntemente selezionato. Scorciatoia: :kbd:`Canc`"

#: ../../reference_manual/main_menu/edit_menu.rst:65
msgid "Fill with Foreground Color"
msgstr "Riempi con colore di primo piano"

#: ../../reference_manual/main_menu/edit_menu.rst:67
msgid "Fills the layer or selection with the foreground color without taking into account blending modes or opacity. Shortcut: :kbd:`Shift + Backspace`"
msgstr ""
"Riempie il livello o la selezione col colore di primo piano senza prendere "
"in considerazione i metodi di fusione o l'opacità. Scorciatoia: :kbd:`Maiusc "
"+ Backspace`"

#: ../../reference_manual/main_menu/edit_menu.rst:68
msgid "Fill with Background Color"
msgstr "Riempi con colore di sfondo"

#: ../../reference_manual/main_menu/edit_menu.rst:70
msgid "Fills the layer or selection with the background color without taking into account blending modes or opacity. Shortcut: :kbd:`Backspace`"
msgstr ""
"Riempie il livello o la selezione col colore di sfondo senza prendere in "
"considerazione i metodi di fusione o l'opacità. Scorciatoia: :kbd:`Backspace`"

#: ../../reference_manual/main_menu/edit_menu.rst:71
msgid "Fill with Pattern"
msgstr "Riempi con motivo"

#: ../../reference_manual/main_menu/edit_menu.rst:73
msgid "Fills the layer or selection with the active pattern without taking into account blending modes or opacity."
msgstr ""
"Riempie il livello o la selezione col motivo attivo senza prendere in "
"considerazione i metodi di fusione o l'opacità."

#: ../../reference_manual/main_menu/edit_menu.rst:74
msgid "Fill with Foreground Color (Opacity)"
msgstr "Riempi con colore di primo piano (opacità)"

#: ../../reference_manual/main_menu/edit_menu.rst:76
msgid "Fills the layer or selection with the foreground color, taking blending modes and opacity into account. Shortcut: :kbd:`Ctrl + Shift + Backspace`"
msgstr ""
"Riempie il livello o la selezione col colore di primo piano, prendendo in "
"considerazione i metodi di fusione e l'opacità. Scorciatoia: :kbd:`Ctrl + "
"Maiusc + Backspace`"

#: ../../reference_manual/main_menu/edit_menu.rst:77
msgid "Fill with Background Color (Opacity)"
msgstr "Riempi con colore di sfondo (opacità)"

#: ../../reference_manual/main_menu/edit_menu.rst:79
msgid "Fills the layer or selection with the background color, taking blending modes and opacity into account. Shortcut: :kbd:`Ctrl + Backspace`"
msgstr ""
"Riempie il livello o la selezione col colore di sfondo, prendendo in "
"considerazione i metodi di fusione e l'opacità. Scorciatoia: :kbd:`Ctrl + "
"Backspace`"

#: ../../reference_manual/main_menu/edit_menu.rst:80
msgid "Fill with Pattern (Opacity)"
msgstr "Riempi con motivo (opacità)"

#: ../../reference_manual/main_menu/edit_menu.rst:82
msgid "Fills the layer or selection with the active pattern, taking blending modes and opacity into account."
msgstr ""
"Riempie il livello o la selezione col motivo attivo prendendo in "
"considerazione i metodi di fusione e l'opacità."

#: ../../reference_manual/main_menu/edit_menu.rst:83
msgid "Stroke Selected Shapes"
msgstr "Tratteggia le forme selezionate"

#: ../../reference_manual/main_menu/edit_menu.rst:85
msgid "Strokes the selected vector shape with the selected brush, will create a new layer."
msgstr ""
"Tratteggia la forma vettoriale selezionata col pennello selezionato, crea un "
"nuovo livello."

#: ../../reference_manual/main_menu/edit_menu.rst:86
msgid "Stroke Selection"
msgstr "Tratteggia la selezione"

#: ../../reference_manual/main_menu/edit_menu.rst:88
msgid "Strokes the active selection using the menu."
msgstr "Tratteggia la selezione attiva utilizzando il menu."
