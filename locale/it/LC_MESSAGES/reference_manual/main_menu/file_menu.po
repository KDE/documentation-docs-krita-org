#: ../../reference_manual/main_menu/file_menu.rst:1
msgid "The file menu in Krita."
msgstr "Il menu File in Krita."

#: ../../reference_manual/main_menu/file_menu.rst:12
#: ../../reference_manual/main_menu/file_menu.rst:29
msgid "Save"
msgstr "Salva"

#: ../../reference_manual/main_menu/file_menu.rst:12
#: ../../reference_manual/main_menu/file_menu.rst:71
msgid "Close"
msgstr "Chiudi"

#: ../../reference_manual/main_menu/file_menu.rst:12
msgid "New File"
msgstr "Nuovo file"

#: ../../reference_manual/main_menu/file_menu.rst:12
msgid "Open"
msgstr "Apri"

#: ../../reference_manual/main_menu/file_menu.rst:12
msgid "Export"
msgstr "Esporta"

#: ../../reference_manual/main_menu/file_menu.rst:12
msgid "Import"
msgstr "Importa"

#: ../../reference_manual/main_menu/file_menu.rst:12
msgid "Template"
msgstr "Modello"

#: ../../reference_manual/main_menu/file_menu.rst:17
msgid "File Menu"
msgstr "Menu File"

#: ../../reference_manual/main_menu/file_menu.rst:20
msgid "New"
msgstr "Nuovo"

#: ../../reference_manual/main_menu/file_menu.rst:22
msgid "Make a new file. Shortcut: :kbd:`Ctrl + N`"
msgstr "Crea un nuovo file. Scorciatoia: :kbd:`Ctrl + N`"

#: ../../reference_manual/main_menu/file_menu.rst:23
msgid "Open..."
msgstr "Apri..."

#: ../../reference_manual/main_menu/file_menu.rst:25
msgid "Open a previously created file. Shortcut: :kbd:`Ctrl + O`"
msgstr "Apre un file esistente. Scorciatoia: :kbd:`Ctrl + O`"

#: ../../reference_manual/main_menu/file_menu.rst:26
msgid "Open Recent"
msgstr "Apri recenti"

#: ../../reference_manual/main_menu/file_menu.rst:28
msgid "Open the recently opened document."
msgstr "Apre il documento aperto di recente."

#: ../../reference_manual/main_menu/file_menu.rst:31
msgid "File formats that Krita can save to. These formats can later be opened back up in Krita. Shortcut: :kbd:`Ctrl + S`"
msgstr ""
"I formati di file in cui Krita è in grado di salvare. Questi formati possono "
"poi essere riaperti in Krita. Scorciatoia: :kbd:`Ctrl + S`"

#: ../../reference_manual/main_menu/file_menu.rst:32
msgid "Save As..."
msgstr "Salva come..."

#: ../../reference_manual/main_menu/file_menu.rst:34
msgid "Save as a new file. Shortcut: :kbd:`Ctrl + Shift + S`"
msgstr "Salva come un nuovo file. Scorciatoia: :kbd:`Ctrl + Maiusc + S`"

#: ../../reference_manual/main_menu/file_menu.rst:35
msgid "Sessions"
msgstr "Sessioni"

#: ../../reference_manual/main_menu/file_menu.rst:37
msgid "This opens the :ref:`working_sessions` manager."
msgstr "Apre il gestore delle :ref:`working_sessions`."

#: ../../reference_manual/main_menu/file_menu.rst:38
msgid "Open existing Document as Untitled Document..."
msgstr "Apri documento esistente come documento senza titolo..."

#: ../../reference_manual/main_menu/file_menu.rst:40
msgid "Similar to import in other programs."
msgstr "Simile all'importazione di altri programmi."

#: ../../reference_manual/main_menu/file_menu.rst:41
msgid "Export..."
msgstr "Esporta..."

#: ../../reference_manual/main_menu/file_menu.rst:43
msgid "Additional formats that can be saved. Some of these formats may not be later imported or opened by Krita."
msgstr ""
"Formati aggiuntivi in cui è possibile salvare. Alcuni di essi potrebbero in "
"seguito non venire importati o aperti da Krita."

#: ../../reference_manual/main_menu/file_menu.rst:44
msgid "Export Advanced..."
msgstr "Esportazione avanzata..."

#: ../../reference_manual/main_menu/file_menu.rst:46
msgid "Similar to export, but it includes crop and resize options."
msgstr ""
"Simile all'esportazione, ma include opzioni di ritaglio e ridimensionamento."

#: ../../reference_manual/main_menu/file_menu.rst:47
msgid "Import Animation Frames..."
msgstr "Importa fotogrammi di animazione..."

#: ../../reference_manual/main_menu/file_menu.rst:49
msgid "Import frames for animation."
msgstr "Importa fotogrammi per l'animazione."

#: ../../reference_manual/main_menu/file_menu.rst:50
msgid "Import Video Animation..."
msgstr "Importa animazione video..."

#: ../../reference_manual/main_menu/file_menu.rst:52
msgid "Import a video animation."
msgstr "Importa un'animazione video."

#: ../../reference_manual/main_menu/file_menu.rst:53
msgid "Render Animation..."
msgstr "Resa animazione..."

#: ../../reference_manual/main_menu/file_menu.rst:55
msgid "Render an animation with FFmpeg. This is explained on the :ref:`render_animation` page."
msgstr ""
"Rende un'animazione con FFmpeg. Trattato alla pagina :ref:`render_animation`."

#: ../../reference_manual/main_menu/file_menu.rst:56
msgid "Save Incremental Version"
msgstr "Salva versione incrementale"

#: ../../reference_manual/main_menu/file_menu.rst:58
msgid "Save as a new version of the same file with a number attached. Shortcut: :kbd:`Ctrl + Alt + S`"
msgstr ""
"Salva come una nuova versione dello stesso file con l'aggiunta di un numero. "
"Scorciatoia: :kbd:`Ctrl + Alt + S`"

#: ../../reference_manual/main_menu/file_menu.rst:59
msgid "Save Incremental Backup"
msgstr "Salva copia di sicurezza incrementale"

#: ../../reference_manual/main_menu/file_menu.rst:61
msgid "Copies and renames the last saved version of your file to a backup file and saves your document under the original name. Shortcut: :kbd:`F4`"
msgstr ""
"Copia e rinomina l'ultima versione salvata del file in una copia di "
"sicurezza e salva il documento col nome originale. Scorciatoia: :kbd:`F4`"

#: ../../reference_manual/main_menu/file_menu.rst:62
msgid "Create Template from Image..."
msgstr "Crea modello da immagine..."

#: ../../reference_manual/main_menu/file_menu.rst:64
msgid "The ``\\*.kra`` file will be saved into the template folder for future use. All your layers and guides will be saved along!"
msgstr ""
"Il file ``\\*.kra`` verrà salvato all'interno della cartella dei modelli per "
"un utilizzo futuro. Vengono salvati anche tutti i livelli e le guide!"

#: ../../reference_manual/main_menu/file_menu.rst:65
msgid "Create Copy from Current Image"
msgstr "Crea copia da immagine attuale"

#: ../../reference_manual/main_menu/file_menu.rst:67
msgid "Makes a new document from the current image, so you can easily reiterate on a single image. Useful for areas where the template system is too powerful."
msgstr ""
"Crea un nuovo documento dall'immagine attuale, in modo che puoi ripetere "
"facilmente una singola immagine. Utile per aree in cui il sistema dei "
"modelli è eccessivo."

#: ../../reference_manual/main_menu/file_menu.rst:68
msgid "Document Information"
msgstr "Informazioni documento"

#: ../../reference_manual/main_menu/file_menu.rst:70
msgid "Look at the document information. Contains all sorts of interesting information about image, such as technical information or metadata."
msgstr ""
"Mostra le informazioni sul documento. Contiene tutte le informazioni utili "
"sull'immagine, come i dati tecnici o i metadati."

#: ../../reference_manual/main_menu/file_menu.rst:73
msgid "Close the view or document. Shortcut: :kbd:`Ctrl + W`"
msgstr "Chiude la vista o il documento. Scorciatoia: :kbd:`Ctrl + W`"

#: ../../reference_manual/main_menu/file_menu.rst:74
msgid "Close All"
msgstr "Chiudi tutto"

#: ../../reference_manual/main_menu/file_menu.rst:76
msgid "Close all views and documents. Shortcut: :kbd:`Ctrl + Shift + W`"
msgstr ""
"Chiude tutte le viste e i documenti. Scorciatoia: :kbd:`Ctrl + Maiusc + W`"

#: ../../reference_manual/main_menu/file_menu.rst:77
msgid "Quit"
msgstr "Esci"

#: ../../reference_manual/main_menu/file_menu.rst:79
msgid "Close Krita. Shortcut: :kbd:`Ctrl + Q`"
msgstr "Chiude Krita. Scorciatoia: :kbd:`Ctrl + Q`"
