#: ../../reference_manual/tools/shape_edit.rst:52
#, fuzzy
#| msgid ""
#| "You can access the Edit Shapes tool by clicking on the icon in the "
#| "toolbox, but you can also access it by pressing the :kbd:`Enter` key when "
#| "in the Shape Selection tool and having a shape selected that can be most "
#| "efficiently edited with the edit shapes tool (right now, that's all "
