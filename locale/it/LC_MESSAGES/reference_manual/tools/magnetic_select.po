#: ../../reference_manual/tools/magnetic_select.rst:11
msgid "Tools"
msgstr "Strumenti"

#: ../../reference_manual/tools/magnetic_select.rst:11
msgid "Magnet"
msgstr "Magnete"

#: ../../reference_manual/tools/magnetic_select.rst:11
