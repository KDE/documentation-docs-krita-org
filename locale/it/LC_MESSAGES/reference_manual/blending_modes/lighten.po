#: ../../reference_manual/blending_modes/lighten.rst:391
msgid "This blending mode is called \"Super Light\" in English."
msgstr ""

#: ../../reference_manual/blending_modes/lighten.rst:393
msgid ""
"Smoother variation of Hard Light blending mode with more contrast in it."
msgstr ""
"Variazione più omogenea del metodo di fusione Luce intensa, con maggiore "
"contrasto."

