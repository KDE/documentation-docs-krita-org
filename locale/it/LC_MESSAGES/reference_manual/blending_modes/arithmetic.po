#: ../../reference_manual/blending_modes/arithmetic.rst:147
msgid ""
"Light Blue(0.1608, 0.6274, 0.8274) x Orange(1, 0.5961, 0.0706) = "
"Green(0.1608, 0.3740, 0.0584)"
msgstr ""
"Blu chiaro(0,1608, 0,6274, 0,8274) x Arancione(1, 0,5961, 0,0706) = "
"Verde(0,1608, 0,3740, 0,0584)"

