msgstr "Sinistra: **Normale**. Destra: **Oscuramento gamma**."

#: ../../reference_manual/blending_modes/darken.rst:152
msgid ""
"Light Blue(0.1608, 0.6274, 0.8274)^[1 / Orange(1, 0.5961, 0.0706)] = "
"Green(0.1608, 0.4575, 0.0683)"
msgstr ""
"Blu chiaro(0,1608, 0,6274, 0,8274)^[1 / Arancione(1, 0,5961, 0,0706)] = "
"Verde(0,1608, 0,4575, 0,0683)"

