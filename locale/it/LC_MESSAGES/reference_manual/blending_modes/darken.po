#: ../../reference_manual/blending_modes/darken.rst:116
msgid "Left: **Normal**. Right: **Darken**."
msgstr "Sinistra: **Normale**. Destra: **Scurisci**."

#: ../../reference_manual/blending_modes/darken.rst:106
msgid ""
"Is Orange(1, 0.5961, 0.0706) darker than Light Blue(0.1608, 0.6274, 0.8274)? "
"= (no, yes, yes) → Green(0.1608, 0.5961, 0.0706)"
msgstr ""
"È Arancione(1, 0,5961, 0,0706) più scuro di Blu chiaro(0,1608, 0,6274, "
"0,8274)? = (no, sì, sì) → Verde(0,1608, 0,5961, 0,0706)"

