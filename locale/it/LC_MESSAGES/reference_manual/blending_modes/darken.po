#: ../../reference_manual/blending_modes/darken.rst:193
msgid "Left: **Normal**. Right: **Linear Burn**."
msgstr "Sinistra: **Normale**. Destra: **Brucia lineare**."

#: ../../reference_manual/blending_modes/darken.rst:183
msgid ""
"[Light Blue(0.1608, 0.6274, 0.8274) + Orange(1, 0.5961, 0.0706)]_1 = "
