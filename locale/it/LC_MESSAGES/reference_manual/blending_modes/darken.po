msgid "Darker Color"
msgstr "Colore più scuro"

#: ../../reference_manual/blending_modes/darken.rst:126
msgid "This blending mode is called \"Darker Color\" in English."
msgstr "Questo metodo di fusione viene chiamato «Darker Color» in inglese."

