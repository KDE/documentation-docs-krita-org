msgid "Guides"
msgstr "Guide"

#: ../../reference_manual/dockers/grids_and_guides.rst:13
msgid "Grid"
msgstr "Griglia"

#: ../../reference_manual/dockers/grids_and_guides.rst:13
msgid "Isometric Grid"
msgstr "Griglia isometrica"

#: ../../reference_manual/dockers/grids_and_guides.rst:13
