#: ../../reference_manual/dockers/touch_docker.rst:15
msgid "Touch Docker"
msgstr "Area di aggancio Tocco"

#: ../../reference_manual/dockers/touch_docker.rst:17
msgid ""
"The Touch Docker is a QML docker with several convenient actions on it. Its "
"purpose is to aid those who use Krita on a touch-enabled screen by providing "
"bigger gui elements."
msgstr ""
"L'area di aggancio Tocco è un'area QML che mette a disposizione varie azioni "
"utili. Il suo scopo è dare un supporto agli utenti che utilizzano Krita su "
"uno schermo a sfioramento, fornendo loro elementi dell'interfaccia con "
"dimensioni maggiori."

