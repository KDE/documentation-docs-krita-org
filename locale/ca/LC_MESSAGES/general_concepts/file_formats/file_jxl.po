#: ../../general_concepts/file_formats/file_jxl.rst:-1
msgid "The JPEG XL file format in Krita."
msgstr "El format de fitxer JPEG XL en el Krita."

#: ../../general_concepts/file_formats/file_jxl.rst:12
msgid "*.jxl"
msgstr "*.jxl"

#: ../../general_concepts/file_formats/file_jxl.rst:12
msgid "JPEG XL"
msgstr "JPEG XL"

#: ../../general_concepts/file_formats/file_jxl.rst:12
msgid "JPEG-XL"
msgstr "JPEG-XL"

#: ../../general_concepts/file_formats/file_jxl.rst:12
msgid "JPEGXL"
msgstr "JPEGXL"

#: ../../general_concepts/file_formats/file_jxl.rst:12
