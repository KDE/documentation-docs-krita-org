msgstr "El format de fitxer d'imatge amb etiquetes al Krita."

#: ../../general_concepts/file_formats/file_tif.rst:10
msgid "*.tif"
msgstr "*.tif"

#: ../../general_concepts/file_formats/file_tif.rst:10
