msgstr "*.tiff"

#: ../../general_concepts/file_formats/file_tif.rst:10
msgid "TIF"
msgstr "TIF"

#: ../../general_concepts/file_formats/file_tif.rst:10
msgid "TIFF"
msgstr "TIFF"

#: ../../general_concepts/file_formats/file_tif.rst:10
msgid "Tagged Image File Format"
msgstr "Format de fitxer d'imatge amb etiquetes"

