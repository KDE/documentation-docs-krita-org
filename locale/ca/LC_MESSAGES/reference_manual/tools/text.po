msgstr "Desselecciona qualsevol text seleccionat."

#: ../../reference_manual/tools/text.rst:93
msgid "Find :kbd:`Ctrl + F`"
msgstr "Cerca :kbd:`Ctrl + F`"

#: ../../reference_manual/tools/text.rst:94
