msgstr "Enganxa el text des del porta-retalls."

#: ../../reference_manual/tools/text.rst:89
msgid "Select all :kbd:`Ctrl + A`"
msgstr "Selecciona-ho tot :kbd:`Ctrl + A`"

#: ../../reference_manual/tools/text.rst:90
