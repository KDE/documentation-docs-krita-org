msgstr ""
"Com obtenir un registre d'ús, la traça inversa o la sortida de text del "
"Krita."

#: ../../reference_manual/sharing_krita_logs.rst:11
msgid "Backtrace"
msgstr "Traça inversa"

#: ../../reference_manual/sharing_krita_logs.rst:11
