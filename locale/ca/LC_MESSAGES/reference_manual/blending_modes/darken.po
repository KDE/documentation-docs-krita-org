#: ../../reference_manual/blending_modes/darken.rst:87
#: ../../reference_manual/blending_modes/darken.rst:91
msgid "Darken"
msgstr "Fosca"

#: ../../reference_manual/blending_modes/darken.rst:18
msgid "Color Burn"
msgstr "Cremat del color"

