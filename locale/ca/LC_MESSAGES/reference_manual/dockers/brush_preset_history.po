#: ../../reference_manual/dockers/brush_preset_history.rst:-1
msgid "The Brush Preset History Docker in Krita."
msgstr "L'acoblador Historial dels pinzells predefinits en el Krita."

#: ../../reference_manual/dockers/brush_preset_history.rst:10
msgid "Brush Preset History"
msgstr "Historial dels pinzells predefinits"

#: ../../reference_manual/dockers/brush_preset_history.rst:10
msgid "Preset"
msgstr "Predefinit"

#: ../../reference_manual/dockers/brush_preset_history.rst:15
msgid "Brush Preset History Docker"
msgstr "Acoblador Historial dels pinzells predefinits"

#: ../../reference_manual/dockers/brush_preset_history.rst:17
msgid "The brush preset history docker keeps track of the last used presets."
msgstr ""
"L'acoblador Historial dels pinzells predefinits realitza un seguiment dels "
"últims predefinits que s'han emprat."

#: ../../reference_manual/dockers/brush_preset_history.rst:20
msgid "Options"
msgstr "Opcions"

#: ../../reference_manual/dockers/brush_preset_history.rst:21
msgid "You can access several features when |mouseright| on a preset."
msgstr ""
"Podreu accedir a diverses característiques quan feu |mouseright| sobre un "
"predefinit."

#: ../../reference_manual/dockers/brush_preset_history.rst:23
msgid "Forget \"Preset Name\""
msgstr "«Nom del predefinit» oblidat"

#: ../../reference_manual/dockers/brush_preset_history.rst:24
msgid "Remove this preset from the list."
msgstr "Traieu aquest predefinit de la llista."

#: ../../reference_manual/dockers/brush_preset_history.rst:25
msgid "Clear History"
msgstr "Neteja l'historial"

#: ../../reference_manual/dockers/brush_preset_history.rst:26
msgid "Clears the list."
msgstr "Neteja la llista."

#: ../../reference_manual/dockers/brush_preset_history.rst:28
msgid "Change how the history behaves:"
msgstr "Canvia com es comporta l'historial:"

#: ../../reference_manual/dockers/brush_preset_history.rst:30
msgid "Static Position"
msgstr "Posició estàtica"

#: ../../reference_manual/dockers/brush_preset_history.rst:31
msgid "All presets keep their positions."
msgstr "Tots els predefinits mantenen les seves posicions."

#: ../../reference_manual/dockers/brush_preset_history.rst:32
msgid "Move to Top on Use"
msgstr "Mou cap a dalt en usar"

#: ../../reference_manual/dockers/brush_preset_history.rst:33
msgid "Move the last used preset to the top."
msgstr "Mou a la part superior l'últim predefinit emprat."

#: ../../reference_manual/dockers/brush_preset_history.rst:34
msgid "Bubble Up on Repeated Use"
msgstr "Bombolleig en un ús repetit"

#: ../../reference_manual/dockers/brush_preset_history.rst:35
msgid "Move presets to the top depending on how often you use them."
msgstr ""
"Mou a la part superior els predefinits depenent de la freqüència amb què es "
"fan servir."

#: ../../reference_manual/dockers/brush_preset_history.rst:37
msgid ""
"How many of the last used presets you want to keep track of. By default this "
"number is 10."
msgstr ""
"Nombre de predefinicions usat recentment voleu mantenir en el seguiment. De "
"manera predeterminada aquest nombre és 10."

#: ../../reference_manual/dockers/brush_preset_history.rst:38
msgid "History Behaviour"
msgstr "Comportament de l'historial"

#: ../../reference_manual/dockers/brush_preset_history.rst:38
msgid "Configure Number of Brushes Shown..."
msgstr "Configura el nombre de pinzells mostrats..."
