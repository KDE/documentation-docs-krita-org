msgid "Guides"
msgstr "Guies"

#: ../../reference_manual/dockers/grids_and_guides.rst:13
msgid "Grid"
msgstr "Quadrícula"

#: ../../reference_manual/dockers/grids_and_guides.rst:13
msgid "Isometric Grid"
msgstr "Quadrícula isomètrica"

#: ../../reference_manual/dockers/grids_and_guides.rst:13
