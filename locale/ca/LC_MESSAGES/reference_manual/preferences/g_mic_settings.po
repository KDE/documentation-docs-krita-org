msgstr "Com configurar el G'Mic al Krita."

#: ../../reference_manual/preferences/g_mic_settings.rst:10
msgid "Preferences"
msgstr "Preferències"

#: ../../reference_manual/preferences/g_mic_settings.rst:10
msgid "Settings"
msgstr "Opcions de configuració"

#: ../../reference_manual/preferences/g_mic_settings.rst:10
msgid "Filters"
