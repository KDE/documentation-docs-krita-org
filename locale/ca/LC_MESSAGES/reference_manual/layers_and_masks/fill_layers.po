#: ../../reference_manual/layers_and_masks/fill_layers.rst:13
msgid "Layers"
msgstr "Capes"

#: ../../reference_manual/layers_and_masks/fill_layers.rst:13
msgid "Fill"
msgstr "Emplenament"

#: ../../reference_manual/layers_and_masks/fill_layers.rst:13
msgid "Generator"
