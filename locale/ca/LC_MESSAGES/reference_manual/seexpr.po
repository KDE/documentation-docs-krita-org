#: ../../reference_manual/seexpr.rst:41
msgid "External variables"
msgstr "Variables externes"

#: ../../reference_manual/seexpr.rst:43
msgid ""
"These variables are provided by host applications, in this case Krita. They "
"are registered with SeExpr's autocomplete help, which can be accessed by :"
"kbd:`Ctrl+Space`."
msgstr ""
"Aquestes variables són proporcionades per les aplicacions amfitrió, en "
"aquest cas el Krita. Estan registrades amb l'ajuda de la compleció "
"automàtica de SeExpr, a la qual es pot accedir mitjançant la drecera :kbd:"
"`Ctrl + Espai`."

#: ../../reference_manual/seexpr.rst:48
msgid "$u, $v"
msgstr "$u, $v"

#: ../../reference_manual/seexpr.rst:50
msgid "Pixel position in normalized coordinates."
msgstr "Posició dels píxels en coordenades normalitzades."

#: ../../reference_manual/seexpr.rst:51
msgid "$w, $h"
msgstr "$w, $h"

#: ../../reference_manual/seexpr.rst:53
msgid "Image's width and height in pixels."
msgstr "Amplada i alçada de la imatge en píxels."

#: ../../reference_manual/seexpr.rst:56
msgid "Local Variables"
msgstr "Variables locals"

#: ../../reference_manual/seexpr.rst:58
msgid "Local variables can be defined at the start of the expression::"
msgstr "Les variables locals es poden definir al començament de l'expressió::"

#: ../../reference_manual/seexpr.rst:60
msgid ""
"$a = noise($P);\n"
"$b = noise($a * 1);\n"
"pow($a, 0.5) + $b"
msgstr ""
"$a = noise($P);\n"
"$b = noise($a * 1);\n"
"pow($a, 0.5) + $b"

#: ../../reference_manual/seexpr.rst:64
msgid ""
"External variables can also be overridden by local assignment. This can be "
"useful to scale the noise frequency for instance::"
msgstr ""
"Les variables externes també es poden sobreescriure mitjançant una "
"assignació local. Això podria ser útil per a escalar la freqüència del "
"soroll, per exemple:"

#: ../../reference_manual/seexpr.rst:66
msgid ""
"$P = $P * 10; # increase noise frequency\n"
"fbm(vnoise($P) + $P/4)"
msgstr ""
"$P = $P * 10; # augmenta la freqüència del soroll\n"
"fbm(vnoise($P) + $P/4)"

#: ../../reference_manual/seexpr.rst:69
msgid "You can also define namespaced variables, e.g.::"
msgstr "També podeu definir variables d'espai de noms, p. ex.::"

#: ../../reference_manual/seexpr.rst:71
msgid "$A::a = $u * 10;"
msgstr "$A::a = $u * 10;"

#: ../../reference_manual/seexpr.rst:75
msgid "Control Structures"
msgstr "Estructures de control"

# skip-rule: t-acc_obe
#: ../../reference_manual/seexpr.rst:77
msgid "SeExpr provides the well-known `if` conditional structure::"
msgstr "El SeExpr proporciona la coneguda estructura condicional `if`::"

#: ../../reference_manual/seexpr.rst:79
msgid ""
"if ($ u > 0.5) {\n"
"    $color = [0, 0, 1];\n"
"}\n"
"else {\n"
"    $color = [1, 0, 0];\n"
"}\n"
"\n"
"$color"
msgstr ""
"if ($ u > 0.5) {\n"
"    $color = [0, 0, 1];\n"
"}\n"
"else {\n"
"    $color = [1, 0, 0];\n"
"}\n"
"\n"
"$color"

# skip-rule: t-acc_obe
#: ../../reference_manual/seexpr.rst:88
msgid "And the *ternary operator*::"
msgstr "I l'*operador ternari*::"

# skip-rule: t-int_sp,t-sp_pu,t-pu_sp
#: ../../reference_manual/seexpr.rst:90
msgid "$u = $i < .5 ? 0.0 : 10.0"
msgstr "$u = $i < .5 ? 0.0 : 10.0"

#: ../../reference_manual/seexpr.rst:92
msgid "You can freely nest ternary operators, e.g.::"
msgstr "Podeu niuar lliurement els operadors ternaris, p. ex:"

# skip-rule: t-sp_2p,t-int_sp,t-sp_pu,t-pu_sp
#: ../../reference_manual/seexpr.rst:94
msgid ""
"$color = $u < .5 ? ($v < 0.5 ? [0, 0, 1] : [1, 0, 0]) : [0, 1, 0];\n"
"$color"
msgstr ""
"$color = $u < .5 ? ($v < 0.5 ? [0, 0, 1] : [1, 0, 0]) : [0, 1, 0];\n"
"$color"

# skip-rule: t-acc_obe
#: ../../reference_manual/seexpr.rst:97
msgid "You can also achieve the same with `if` structures::"
msgstr "També podeu aconseguir el mateix amb les estructures `if`:"

#: ../../reference_manual/seexpr.rst:99
msgid ""
"if ($ u > 0.5) {\n"
"    if ($v < 0.5) {\n"
"        $color = [0, 0, 1];\n"
"    }\n"
"    else {\n"
"        $color = [1, 0, 0];\n"
"    }\n"
"}\n"
"else {\n"
"    $color = [1, 0, 0];\n"
"}\n"
"\n"
"$color"
msgstr ""
"if ($ u > 0.5) {\n"
"    if ($v < 0.5) {\n"
"        $color = [0, 0, 1];\n"
"    }\n"
"    else {\n"
"        $color = [1, 0, 0];\n"
"    }\n"
"}\n"
"else {\n"
"    $color = [1, 0, 0];\n"
"}\n"
"\n"
"$color"

