#: ../../reference_manual/seexpr.rst:710 ../../reference_manual/seexpr.rst:724
msgid "3 - spline"
msgstr "3 - spline"

#: ../../reference_manual/seexpr.rst:711 ../../reference_manual/seexpr.rst:725
