#: ../../reference_manual/blending_modes/negative.rst:91
msgid "Negation"
msgstr ""

#: ../../reference_manual/blending_modes/negative.rst:93
msgid ""
"The absolute of the 1.0f value subtracted by base subtracted by the blend "
"layer. abs(1.0f - Base - Blend)"
msgstr ""

