#: ../../general_concepts/file_formats/file_radiance_hdr.rst:-1
msgid "The Radiance HDR file formats in Krita."
msgstr "Форматы файлов Radiance HDR в Krita"

#: ../../general_concepts/file_formats/file_radiance_hdr.rst:10
#: ../../general_concepts/file_formats/file_radiance_hdr.rst:15
msgid "\\*.hdr"
msgstr "\\*.hdr"

#: ../../general_concepts/file_formats/file_radiance_hdr.rst:10
msgid "Radiance HDR !RGBE \\*.heic"
