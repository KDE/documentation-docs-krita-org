#: ../../reference_manual/tools/rectangular_select.rst:13
msgid "Tools"
msgstr "Инструменты"

#: ../../reference_manual/tools/rectangular_select.rst:13
msgid "Selection"
msgstr "Выделение"

#: ../../reference_manual/tools/rectangular_select.rst:13
