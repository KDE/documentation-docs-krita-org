msgid "Photoshop Swatches (.aco)"
msgstr "Образцы Photoshop (.aco)"

#: ../../reference_manual/dockers/palette_docker.rst:98
msgid "Scribus XML (.xml)"
msgstr "Scribus XML (.xml)"

#: ../../reference_manual/dockers/palette_docker.rst:99
msgid "Swatchbooker (.sbz)"
msgstr "Swatchbooker (.sbz)"

#: ../../reference_manual/dockers/palette_docker.rst:100
msgid "Adobe Swatch Exchange (.ase)"
msgstr "Adobe Swatch Exchange (.ase)"

#: ../../reference_manual/dockers/palette_docker.rst:101
