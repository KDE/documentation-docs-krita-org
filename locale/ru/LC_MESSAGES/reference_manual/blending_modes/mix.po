#: ../../reference_manual/blending_modes/mix.rst:396
msgid "Left: **Normal**. Right: **Penumbra A**."
msgstr "Слева: **Обычный**. Справа: **Полутень A**."

#: ../../reference_manual/blending_modes/mix.rst:398
#: ../../reference_manual/blending_modes/mix.rst:402
msgid "Penumbra B"
msgstr "Полутень B"

#: ../../reference_manual/blending_modes/mix.rst:406
msgid "This blending mode is called \"Penumbra B\" in English."
msgstr "В английском языке этот режим смешивания называется «Penumbra B»."

#: ../../reference_manual/blending_modes/mix.rst:408
msgid "Penumbra A with source and destination layer swapped."
msgstr "Полутень A с переставленными исходным и целевым слоями."

