#: ../../404.rst:6
msgid "File Not Found (404)"
msgstr "Tiedostoa ei löydy (404)"

#: ../../404.rst:11
msgid "This page does not exist."
msgstr "Tätä sivua ei ole olemassa."

#: ../../404.rst:13
msgid "This might be because of the following:"
msgstr "Syynä saattaa olla:"

#: ../../404.rst:15
msgid ""
"We moved the manual from MediaWiki to Sphinx and with that came a lot of "
"reorganization."
msgstr ""
"siirsimme käyttöoppaan MediaWikistä Sphinxiin, mistä seurasi "
"uudelleenjärjestelyjä"

#: ../../404.rst:16
msgid "The page has been deprecated."
msgstr "sivu on vanhentunut"

#: ../../404.rst:17
msgid "Or a simple typo in the URL."
msgstr "tai yksinkertaisesti kirjoitusvirhe verkko-osoitteessa."

#: ../../404.rst:19
msgid ""
"In all cases, you might be able to find the page you're looking for by using "
"the search in the left hand navigation."
msgstr ""
"Voit joka tapauksessa löytää etsimäsi sivun käyttämällä vasemman reunan "
"hakua."
