#~ msgstr "mouseleft"

#~ msgid ".. image:: images/icons/Krita_mouse_left.png"
#~ msgstr ".. image:: images/icons/Krita_mouse_left.png"

#~ msgid "mouseright"
#~ msgstr "mouseright"

#~ msgid ".. image:: images/icons/Krita_mouse_right.png"
#~ msgstr ".. image:: images/icons/Krita_mouse_right.png"

