msgid "*.kra"
msgstr "*.kra"

#: ../../general_concepts/file_formats/file_kra.rst:10
msgid "KRA"
msgstr "KRA"

#: ../../general_concepts/file_formats/file_kra.rst:10
msgid "Krita Archive"
msgstr "Архів Krita"

#: ../../general_concepts/file_formats/file_kra.rst:10
