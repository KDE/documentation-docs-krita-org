#: ../../general_concepts/file_formats/file_gih.rst:1
msgid "The GIMP Image Hose file format in Krita."
msgstr "Формат файлів футляра зображень GIMP (GIH) у Krita."

#: ../../general_concepts/file_formats/file_gih.rst:10
msgid "*.gih"
msgstr "*.gih"

#: ../../general_concepts/file_formats/file_gih.rst:10
msgid "GIH"
