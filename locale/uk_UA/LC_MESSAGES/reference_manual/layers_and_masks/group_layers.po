#: ../../reference_manual/layers_and_masks/group_layers.rst:-1
msgid "How to use group layers in Krita."
msgstr "Як користуватися групуванням шарів у Krita."

#: ../../reference_manual/layers_and_masks/group_layers.rst:12
msgid "Layers"
msgstr "Шари"

#: ../../reference_manual/layers_and_masks/group_layers.rst:12
msgid "Groups"
msgstr "Групи"

#: ../../reference_manual/layers_and_masks/group_layers.rst:12
