#: ../../reference_manual/dockers/arrange.rst:-1
msgid "The arrange docker."
msgstr "Бічна панель упорядковування."

#: ../../reference_manual/dockers/arrange.rst:14
msgid "Arrange"
msgstr "Компонування"

#: ../../reference_manual/dockers/arrange.rst:16
msgid ""
"A docker for aligning and arranging vector shapes. When you have the "
":ref:`shape_selection_tool` active, the following actions will appear on "
"this docker:"
msgstr ""
"Бічна панель для вирівнювання і упорядковування векторних форм. Якщо задіяно"
" :ref:`shape_selection_tool`, на цій бічній панелі буде показано такі пункти"
" дій:"

#: ../../reference_manual/dockers/arrange.rst:19
msgid "Align all selected objects."
msgstr "Вирівняти усі позначені об'єкти."

#: ../../reference_manual/dockers/arrange.rst:21
msgid "Align Left"
msgstr "Вирівняти ліворуч"

#: ../../reference_manual/dockers/arrange.rst:22
msgid "Horizontally Center"
msgstr "Горизонтально за центром"

#: ../../reference_manual/dockers/arrange.rst:23
msgid "Align Right"
msgstr "Вирівняти праворуч"

#: ../../reference_manual/dockers/arrange.rst:24
msgid "Align Top"
msgstr "Вирівняти за верхнім краєм"

#: ../../reference_manual/dockers/arrange.rst:25
msgid "Vertically Center"
msgstr "Вертикально за центром"

#: ../../reference_manual/dockers/arrange.rst:26
msgid "Align"
msgstr "Вирівняти"

#: ../../reference_manual/dockers/arrange.rst:26
msgid "Align Bottom"
msgstr "Вирівняти за нижнім краєм"

#: ../../reference_manual/dockers/arrange.rst:29
msgid "Ensure that objects are distributed evenly."
msgstr "Рівномірно розподілити об'єкти."

#: ../../reference_manual/dockers/arrange.rst:31
msgid "Distribute left edges equidistantly."
msgstr "Рівномірно розподілити ліві краї."

#: ../../reference_manual/dockers/arrange.rst:32
msgid "Distribute centers equidistantly horizontally."
msgstr "Розподілити центри об’єктів на однаковій відстані горизонтально."

#: ../../reference_manual/dockers/arrange.rst:33
msgid "Distribute right edges equidistantly."
msgstr "Рівномірно розподілити праві краї."

#: ../../reference_manual/dockers/arrange.rst:34
msgid "Distribute top edges equidistantly."
msgstr "Рівномірно розподілити верхні краї."

#: ../../reference_manual/dockers/arrange.rst:35
msgid "Distribute centers equidistantly vertically."
msgstr "Розподілити центри об’єктів на однаковій відстані вертикально."

#: ../../reference_manual/dockers/arrange.rst:36
msgid "Distribute"
msgstr "Розподілити"

#: ../../reference_manual/dockers/arrange.rst:36
msgid "Distribute bottom edges equidistantly."
msgstr "Рівномірно розподілити нижні краї."

#: ../../reference_manual/dockers/arrange.rst:39
msgid "Ensure the gaps between objects are equal."
msgstr "Зробити проміжки між об'єктами однаковими."

#: ../../reference_manual/dockers/arrange.rst:41
msgid "Make horizontal gaps between object equal."
msgstr "Зробити горизонтальні проміжки між об'єктами однаковими.."

#: ../../reference_manual/dockers/arrange.rst:42
msgid "Spacing"
msgstr "Інтервал"

#: ../../reference_manual/dockers/arrange.rst:42
msgid "Make vertical gaps between object equal."
msgstr "Зробити вертикальні проміжки між об'єктами однаковими."

#: ../../reference_manual/dockers/arrange.rst:45
msgid "Change the order of vector objects."
msgstr "Змінити порядок векторних об'єктів."

#: ../../reference_manual/dockers/arrange.rst:47
msgid "Bring to front"
msgstr "Перемістити на передній план"

#: ../../reference_manual/dockers/arrange.rst:48
msgid "Raise"
msgstr "Підняти"

#: ../../reference_manual/dockers/arrange.rst:49
msgid "Lower"
msgstr "Опустити"

#: ../../reference_manual/dockers/arrange.rst:50
msgid "Order"
msgstr "Порядок"

#: ../../reference_manual/dockers/arrange.rst:50
msgid "Bring to back"
msgstr "Перемістити на задній план"

#: ../../reference_manual/dockers/arrange.rst:53
msgid "Buttons to group and ungroup vector objects."
msgstr "Кнопки для групування та розгрупування векторних об'єктів."

#: ../../reference_manual/dockers/arrange.rst:54
msgid "Grouping"
msgstr "Групування"

