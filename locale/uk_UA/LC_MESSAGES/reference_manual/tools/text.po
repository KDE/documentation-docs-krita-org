#~ "вилучення цих властивостей."

#~ msgid "Insert"
#~ msgstr "Вставити"

#~ msgid "Special Character... :kbd:`Alt + Shift + C`"
#~ msgstr "Спеціальний символ… :kbd:`Alt + Shift + C`"

#~ msgid ""
#~ "Pops up a dialog that allows you to search for special characters that "
#~ "are difficult to type in with your keyboard."
#~ msgstr ""
