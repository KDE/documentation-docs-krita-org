#~ msgid "Open Krita with specified Screen DPI."
#~ msgstr "Відкриття вікна Krita із вказаною роздільністю екрана."

#~ msgid "For example:"
#~ msgstr "Приклад:"

#~ msgid "``krita --dpi <72,72>``"
#~ msgstr "``krita --dpi <72,72>``"
