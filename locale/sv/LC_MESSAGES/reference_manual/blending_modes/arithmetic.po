#: ../../reference_manual/blending_modes/arithmetic.rst:42
msgid "Red(1, 0, 0) + Gray(0.5, 0.5, 0.5) = Pink(1, 0.5, 0.5)"
msgstr "Röd(1, 0, 0) + Grå(0.5, 0.5, 0.5) = Rosa(1, 0.5, 0.5)"

#: ../../reference_manual/blending_modes/arithmetic.rst:47
msgid ""
