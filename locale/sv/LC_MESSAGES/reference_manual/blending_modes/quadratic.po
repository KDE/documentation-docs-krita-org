msgid "Freeze"
msgstr "Frys"

#: ../../reference_manual/blending_modes/quadratic.rst:30
msgid "This blending mode is called \"Freeze\" in English."
msgstr "Blandningsläget kallas \"Freeze\" på engelska."

#: ../../reference_manual/blending_modes/quadratic.rst:32
msgid "The Freeze blending mode. Inversion of the Reflect blending mode."
msgstr "Blandningsläget Frys. Invertering av av blandningsläget Reflektera."

