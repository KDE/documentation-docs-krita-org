msgstr "Färgton"

#: ../../reference_manual/dockers/color_sliders.rst:11
msgid "Saturation"
msgstr "Färgmättnad"

#: ../../reference_manual/dockers/color_sliders.rst:11
msgid "Value"
msgstr "Värde"

#: ../../reference_manual/dockers/color_sliders.rst:11
msgid "Brightness"
msgstr "Ljusstyrka"

#: ../../reference_manual/dockers/color_sliders.rst:11
msgid "Lightness"
msgstr "Ljushet"

#: ../../reference_manual/dockers/color_sliders.rst:11
msgid "Intensity"
msgstr "Intensitet"

#: ../../reference_manual/dockers/color_sliders.rst:11
