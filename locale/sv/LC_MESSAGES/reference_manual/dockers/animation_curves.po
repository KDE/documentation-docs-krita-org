msgstr "Vänsterklick på ögonikonen: Visa eller dölj kanal."

#: ../../reference_manual/dockers/animation_curves.rst:125
msgid ":kbd:`Shift +` |mouseleft| on Eye Icon: Solo channel."
msgstr ":kbd:`Skift +` vänster musknapp på ögonikonen: Ensam kanal."

#: ../../reference_manual/dockers/animation_curves.rst:126
msgid "|mouseright| : Open layer or channel context menu. [Reset Channel(s)]"
msgstr ""
"Höger musknapp: Öppna lagrets eller kanalens sammanhangsberoende meny. "
"[Återställ kanal(er)]"

#: ../../reference_manual/dockers/animation_curves.rst:128
msgid ":dfn:`Graph View`"
msgstr ":dfn:`Diagramvisning`"

#: ../../reference_manual/dockers/animation_curves.rst:130
msgid "|mouseleft| : Select keyframe."
msgstr "Vänster musknapp: Markera nyckelbild."

#: ../../reference_manual/dockers/animation_curves.rst:131
