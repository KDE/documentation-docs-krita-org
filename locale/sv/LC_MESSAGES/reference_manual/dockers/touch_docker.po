#: ../../reference_manual/dockers/touch_docker.rst:10
msgid "Touch"
msgstr "Beröring"

#: ../../reference_manual/dockers/touch_docker.rst:10
msgid "Finger"
msgstr "Finger"

#: ../../reference_manual/dockers/touch_docker.rst:10
msgid "Tablet UI"
msgstr "Användargränssnitt för ritplatta"

#: ../../reference_manual/dockers/touch_docker.rst:15
msgid "Touch Docker"
msgstr "Pekpanel"

#: ../../reference_manual/dockers/touch_docker.rst:17
msgid ""
"The Touch Docker is a QML docker with several convenient actions on it. Its "
"purpose is to aid those who use Krita on a touch-enabled screen by providing "
"bigger gui elements."
msgstr ""
"Pekpanelen är en QML-panel med flera bekväma åtgärder. Syftet är att hjälpa "
"de som använder Krita på en pekskärm genom att tillhandahålla större "
"grafiska användarelement."

#: ../../reference_manual/dockers/touch_docker.rst:19
msgid "Its actions are..."
msgstr "Dess åtgärder är ..."

#: ../../reference_manual/dockers/touch_docker.rst:24
msgid "Open File"
msgstr "Öppna fil"

#: ../../reference_manual/dockers/touch_docker.rst:24
msgid "Save File"
msgstr "Spara fil"

#: ../../reference_manual/dockers/touch_docker.rst:24
msgid "Save As..."
msgstr "Spara som..."

