#: ../../reference_manual/tools/shape_selection.rst:-1
msgid "Krita's shape selection tool reference."
msgstr "Referens för Kritas formmarkeringsverktyg."

#: ../../reference_manual/tools/shape_selection.rst:-1
msgid "Tool options: Geometry tool."
msgstr "Verktygsalternativ: geometriverktyg."

#: ../../reference_manual/tools/shape_selection.rst:-1
msgid ".. image:: /images/tools/shape-selection-menu-geometry.png"
msgstr ".. image:: /images/tools/shape-selection-menu-geometry.png"

#: ../../reference_manual/tools/shape_selection.rst:-1
