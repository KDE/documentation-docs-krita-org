#: ../../reference_manual/preferences/general_settings.rst:12
msgid "Autosave"
msgstr "Spara automatiskt"

#: ../../reference_manual/preferences/general_settings.rst:12
msgid "Tabbed Documents"
msgstr "Dokument med flikar"

#: ../../reference_manual/preferences/general_settings.rst:12
msgid "Subwindow Documents"
msgstr "Dokument med delfönster"

#: ../../reference_manual/preferences/general_settings.rst:12
msgid "Pop up palette"
msgstr "Palettruta"

#: ../../reference_manual/preferences/general_settings.rst:12
msgid "File Dialog"
msgstr "Fildialogruta"

#: ../../reference_manual/preferences/general_settings.rst:12
msgid "Maximum Brush Size"
msgstr "Maximal penselstorlek"

#: ../../reference_manual/preferences/general_settings.rst:12
