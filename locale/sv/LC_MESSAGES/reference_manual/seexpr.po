msgid ""
"color **cvoronoi** ( vector v, int type = 1, float jitter = 0.5, float "
"fbmScale = 0, int fbmOctaves = 4, float fbmLacunarity = 2, float "
"fbmGain = 0.5)"
msgstr ""
