#: ../../user_manual/getting_started/navigation.rst:13
#: ../../user_manual/getting_started/navigation.rst:18
msgid "Navigation"
msgstr "Navigering"

#: ../../user_manual/getting_started/navigation.rst:13
#: ../../user_manual/getting_started/navigation.rst:115
msgid "Pop-up Palette"
msgstr "Palettruta"

#: ../../user_manual/getting_started/navigation.rst:13
msgid "Zoom"
msgstr "Zooma"

#: ../../user_manual/getting_started/navigation.rst:13
msgid "Rotate"
msgstr "Rotera"

#: ../../user_manual/getting_started/navigation.rst:13
