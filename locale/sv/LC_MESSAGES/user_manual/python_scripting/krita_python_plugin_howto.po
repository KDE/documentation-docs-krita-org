#: ../../user_manual/python_scripting/krita_python_plugin_howto.rst:79
msgid "in your Krita :file:`resources/pykrita` directory create"
msgstr "skapa följande i Kritas katalog :file:`resources/pykrita`"

#: ../../user_manual/python_scripting/krita_python_plugin_howto.rst:79
