#: ../../user_manual/getting_started/starting_krita.rst:1
msgid ""
"A simple guide to the first basic steps of using Krita: creating and saving "
"an image."
msgstr ""
"Un simple guide sur les premières étapes basiques pour utiliser Krita : "
"créer et enregistrer une image."

#: ../../user_manual/getting_started/starting_krita.rst:18
msgid "Getting started"
msgstr "Démarrage"

#: ../../user_manual/getting_started/starting_krita.rst:18
msgid "Save"
msgstr "Enregistrer"

#: ../../user_manual/getting_started/starting_krita.rst:18
msgid "Load"
msgstr "Charger"

#: ../../user_manual/getting_started/starting_krita.rst:18
msgid "New"
