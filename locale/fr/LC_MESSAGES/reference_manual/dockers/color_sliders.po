msgstr "Aperçu du panneau pour les curseurs de couleurs."

#: ../../reference_manual/dockers/color_sliders.rst:11
#: ../../reference_manual/dockers/color_sliders.rst:16
msgid "Color Sliders"
msgstr "Curseurs de couleurs"

#: ../../reference_manual/dockers/color_sliders.rst:11
msgid "Color"
msgstr "Couleur"

#: ../../reference_manual/dockers/color_sliders.rst:11
msgid "Color Selector"
msgstr "Sélecteur de couleurs"

#: ../../reference_manual/dockers/color_sliders.rst:11
msgid "Hue"
msgstr "Teinte"

#: ../../reference_manual/dockers/color_sliders.rst:11
msgid "Saturation"
msgstr "Saturation"

#: ../../reference_manual/dockers/color_sliders.rst:11
msgid "Value"
msgstr "Valeur"

#: ../../reference_manual/dockers/color_sliders.rst:11
msgid "Brightness"
msgstr "Luminosité"

#: ../../reference_manual/dockers/color_sliders.rst:11
msgid "Lightness"
msgstr "Luminosité"

#: ../../reference_manual/dockers/color_sliders.rst:11
msgid "Intensity"
msgstr "Intensité"

#: ../../reference_manual/dockers/color_sliders.rst:11
