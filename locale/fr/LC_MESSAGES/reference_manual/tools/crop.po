#: ../../reference_manual/tools/crop.rst:11
msgid "Tools"
msgstr "Outils"

#: ../../reference_manual/tools/crop.rst:11
msgid "Crop"
msgstr "Rognage"

#: ../../reference_manual/tools/crop.rst:11
