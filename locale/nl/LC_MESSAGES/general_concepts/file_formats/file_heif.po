msgstr "De bestandsformaten HEIF en AVIF in Krita."

#: ../../general_concepts/file_formats/file_heif.rst:10
msgid "High Efficiency Image Format"
msgstr "High efficiency afbeeldingsformaat (HEIF)"

#: ../../general_concepts/file_formats/file_heif.rst:10
