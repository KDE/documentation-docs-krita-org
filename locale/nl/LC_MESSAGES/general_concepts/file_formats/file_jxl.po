msgstr "Metagegevens van documenten opslaan."

#: ../../general_concepts/file_formats/file_jxl.rst:249
msgid ""
"Whether to store any metadata at all. You can individually toggle"
" :guilabel:"
"`Exif`, :guilabel:`IPTC` and :guilabel:`XMP`."
msgstr ""
"Of enige metadata moet worden opgeslagen. U kunt :guilabel:`Exif`,"
" :guilabel:"
"`IPTC` en :guilabel:`XMP` apart instellen."

#: ../../general_concepts/file_formats/file_jxl.rst:250
msgid "Anonymizer"
msgstr "Anoniem maken"

#: ../../general_concepts/file_formats/file_jxl.rst:251
msgid "Whether to remove author information."
msgstr "Of de informatie over de auteur verwijderd moet worden."

#: ../../general_concepts/file_formats/file_jxl.rst:253
msgid "Tool information"
msgstr "Hulpmiddeleninformatie"

#: ../../general_concepts/file_formats/file_jxl.rst:253
msgid "Whether to add tool information."
msgstr "Of informatie over het programma toegevoegd moet worden."

