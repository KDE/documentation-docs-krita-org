#: ../../reference_manual/seexpr.rst:38
msgid "Variables"
msgstr "Variabelen"

#: ../../reference_manual/seexpr.rst:41
msgid "External variables"
msgstr "Externe variabelen"

#: ../../reference_manual/seexpr.rst:43
msgid ""
"These variables are provided by host applications, in this case Krita. They "
"are registered with SeExpr's autocomplete help, which can be accessed by :"
"kbd:`Ctrl+Space`."
msgstr ""
"Deze variabelen worden geleverd door het host-programma, in dit geval Krita. "
"Ze zijn verzamelt met de autocomplete help van SeExpr, die u kunt starten "
"met :kbd:`Ctrl+Space`."

#: ../../reference_manual/seexpr.rst:48
msgid "$u, $v"
msgstr "$u, $v"

#: ../../reference_manual/seexpr.rst:50
msgid "Pixel position in normalized coordinates."
msgstr "Pixelpositie in genormaliseerde coördinaten."

#: ../../reference_manual/seexpr.rst:51
msgid "$w, $h"
msgstr "$w, $h"

#: ../../reference_manual/seexpr.rst:53
msgid "Image's width and height in pixels."
msgstr "De breedte en hoogte van de afbeelding in pixels."

#: ../../reference_manual/seexpr.rst:56
msgid "Local Variables"
msgstr "Lokale variabelen"

#: ../../reference_manual/seexpr.rst:58
msgid "Local variables can be defined at the start of the expression::"
msgstr ""
"Lokale variabelen kunnen aan het begin van een script worden gedefinieerd."

#: ../../reference_manual/seexpr.rst:60
msgid ""
"$a = noise($P);\n"
"$b = noise($a * 1);\n"
"pow($a, 0.5) + $b"
msgstr ""
"$a = noise($P);\n"
"$b = noise($a * 1);\n"
"pow($a, 0.5) + $b"

#: ../../reference_manual/seexpr.rst:64
msgid ""
"External variables can also be overridden by local assignment. This can be "
"useful to scale the noise frequency for instance::"
msgstr ""
"Externe variabelen kunnen ook lokaal worden overschreven. Dit kan handig "
"zijn als u bijvoorbeeld de ruis-frequentie wilt aanpassen."

#: ../../reference_manual/seexpr.rst:66
msgid ""
"$P = $P * 10; # increase noise frequency\n"
"fbm(vnoise($P) + $P/4)"
msgstr ""
"$P = $P * 10; # ruisfrequentie verhogen\n"
"fbm(vnoise($P) + $P/4)"

#: ../../reference_manual/seexpr.rst:69
msgid "You can also define namespaced variables, e.g.::"
msgstr "U kunt ook namespaced variabelen definiëren, b.v.::"

#: ../../reference_manual/seexpr.rst:71
msgid "$A::a = $u * 10;"
msgstr "$A::a = $u * 10;"

#: ../../reference_manual/seexpr.rst:75
msgid "Control Structures"
msgstr "Besturingsstructuren"

#: ../../reference_manual/seexpr.rst:77
msgid "SeExpr provides the well-known `if` conditional structure::"
msgstr "Bij SeExpr zijn ook structuren met de bekende `if` conditie mogelijk::"

#: ../../reference_manual/seexpr.rst:79
msgid ""
"if ($ u > 0.5) {\n"
"    $color = [0, 0, 1];\n"
"}\n"
"else {\n"
"    $color = [1, 0, 0];\n"
"}\n"
"\n"
"$color"
msgstr ""
"if ($ u > 0.5) {\n"
"    $color = [0, 0, 1];\n"
"}\n"
"else {\n"
"    $color = [1, 0, 0];\n"
"}\n"
"\n"
"$color"

#: ../../reference_manual/seexpr.rst:88
msgid "And the *ternary operator*::"
msgstr "En de *ternaire operator*::"

#: ../../reference_manual/seexpr.rst:90
msgid "$u = $i < .5 ? 0.0 : 10.0"
msgstr "$u = $i < .5 ? 0.0 : 10.0"

#: ../../reference_manual/seexpr.rst:92
msgid "You can freely nest ternary operators, e.g.::"
msgstr "U kunt naar wens ternaire operators nesten, bijv.::"

#: ../../reference_manual/seexpr.rst:94
msgid ""
"$color = $u < .5 ? ($v < 0.5 ? [0, 0, 1] : [1, 0, 0]) : [0, 1, 0];\n"
"$color"
msgstr ""
"$color = $u < .5 ? ($v < 0.5 ? [0, 0, 1] : [1, 0, 0]) : [0, 1, 0];\n"
"$color"

#: ../../reference_manual/seexpr.rst:97
msgid "You can also achieve the same with `if` structures::"
msgstr "U kunt hetzelfde bereiken met de `if` structuren::"

#: ../../reference_manual/seexpr.rst:99
msgid ""
"if ($ u > 0.5) {\n"
"    if ($v < 0.5) {\n"
"        $color = [0, 0, 1];\n"
"    }\n"
"    else {\n"
"        $color = [1, 0, 0];\n"
"    }\n"
"}\n"
"else {\n"
"    $color = [1, 0, 0];\n"
"}\n"
"\n"
"$color"
msgstr ""
"if ($ u > 0.5) {\n"
"    if ($v < 0.5) {\n"
"        $color = [0, 0, 1];\n"
"    }\n"
"    else {\n"
"        $color = [1, 0, 0];\n"
"    }\n"
"}\n"
"else {\n"
"    $color = [1, 0, 0];\n"
"}\n"
"\n"
"$color"

#: ../../reference_manual/seexpr.rst:115
msgid "Operators (listed in decreasing precedence)"
msgstr "Opdrachten (in aflopende volgorde)"

#: ../../reference_manual/seexpr.rst:118
msgid "[a,b,c]"
msgstr "[a,b,c]"

#: ../../reference_manual/seexpr.rst:120
msgid "vector constructor"
msgstr "maker van vectorconstructie"

#: ../../reference_manual/seexpr.rst:121
