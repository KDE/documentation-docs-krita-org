#: ../../reference_manual/blending_modes/mix.rst:126
msgid "Geometric Mean"
msgstr "Meetkundig gemiddelde"

#: ../../reference_manual/blending_modes/mix.rst:130
msgid "This blending mode is called \"Geometric Mean\" in English."
msgstr ""

#: ../../reference_manual/blending_modes/mix.rst:132
msgid ""
"This blending mode multiplies the top layer with the bottom, and then "
"outputs the square root of that."
msgstr ""
"Deze mengmethode vermenigvuldigt de bovenliggende laag met de onderliggende "
"laag, en neemt daarna de wortel daarvan."

