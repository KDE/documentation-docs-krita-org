#: ../../reference_manual/blending_modes/mix.rst:156
#: ../../reference_manual/blending_modes/mix.rst:160
msgid "Grain Merge"
msgstr "Grain Merge"

#: ../../reference_manual/blending_modes/mix.rst:164
msgid "This blending mode is called \"Grain Merge\" in English."
msgstr ""

#: ../../reference_manual/blending_modes/mix.rst:166
msgid ""
"Similar to addition, the colors of the upper layer are added to the colors, "
"and then 50% gray is subtracted."
msgstr ""
"Vergelijkbaar met optellen, de kleuren op de bovenliggende laag worden bij "
"de kleuren op de onderliggende laag opgeteld, waarna, waarna 50% grijs wordt "
"afgetrokken."

