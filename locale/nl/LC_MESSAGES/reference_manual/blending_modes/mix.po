#: ../../reference_manual/blending_modes/mix.rst:139
#: ../../reference_manual/blending_modes/mix.rst:143
msgid "Grain Extract"
msgstr "Grain Extract"

#: ../../reference_manual/blending_modes/mix.rst:147
msgid "This blending mode is called \"Grain Extract\" in English."
msgstr ""

#: ../../reference_manual/blending_modes/mix.rst:149
msgid ""
"Similar to subtract, the colors of the upper layer are subtracted from the "
"colors of the lower layer, and then 50% gray is added."
msgstr ""
"Vergelijkbaar met aftrekken, de kleuren op de bovenliggende laag worden van "
"de kleuren op de onderliggende laag afgetrokken, waarna, waarna 50% grijs "
"wordt toegevoegd."

