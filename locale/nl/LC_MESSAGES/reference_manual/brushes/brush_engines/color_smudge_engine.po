#~ "function off."
#~ msgstr ""
#~ "Om de uitsmeermodus beter te demonstreren, heb ik de kleurverloopsnelheid "
#~ "uitgeschakeld."

#~ msgid ".. image:: images/brushes/Krita-tutorial5-I.2.png"
#~ msgstr ".. image:: images/brushes/Krita-tutorial5-I.2.png"

