msgid "Quick Brush Engine"
msgstr "Snelpenseel-engine"

#: ../../reference_manual/brushes/brush_engines/quick_brush_engine.rst:10
msgid "Brush Engine"
msgstr "Penseel-engine"

#: ../../reference_manual/brushes/brush_engines/quick_brush_engine.rst:19
