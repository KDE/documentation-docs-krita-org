msgstr "Hoe selectiemaskers in Krita te gebruiken."

#: ../../reference_manual/layers_and_masks/selection_masks.rst:15
msgid "Layers"
msgstr "Lagen"

#: ../../reference_manual/layers_and_masks/selection_masks.rst:15
