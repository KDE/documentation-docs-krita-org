#: ../../reference_manual/filters/edge_detection.rst:-1
msgid "Overview of the edge detection filters."
msgstr "Przegląd filtrów wykrywających krawędzie."

#: ../../reference_manual/filters/edge_detection.rst:-1
#, fuzzy
#| msgid ".. image:: images/filters/Krita_4_0_height_to_normal_map.png"
msgid ".. image:: /images/filters/Krita_4_0_height_to_normal_map.png"
