".. image:: images/blending_modes/quadratic/"
"Blending_modes_Q_Glow_Heat_Light_blue_and_Orange.png"

#: ../../reference_manual/blending_modes/quadratic.rst:86
msgid "Left: **Normal**. Right: **Glow_Heat**."
msgstr "Po lewej: **Normalny**. Po prawej: **Poświata/ciepło**."

#: ../../reference_manual/blending_modes/quadratic.rst:91
msgid "Heat"
msgstr "Ciepło"

#: ../../reference_manual/blending_modes/quadratic.rst:95
msgid "This blending mode is called \"Heat\" in English."
msgstr "Ten tryb mieszania po angielsku nazywa się \"Heat\"."

#: ../../reference_manual/blending_modes/quadratic.rst:97
msgid "The Heat blending mode. Inversion of the Glow blending mode."
msgstr "Tryb ciepłego mieszania. Odwrócenie trybu mieszania poświaty."

