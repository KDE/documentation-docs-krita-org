#: ../../reference_manual/blending_modes/quadratic.rst:103
msgid "Left: **Normal**. Right: **Heat**."
msgstr "Po lewej: **Normalny**. Po prawej: **Ciepło**."

#: ../../reference_manual/blending_modes/quadratic.rst:108
msgid "Heat-Glow"
msgstr "Ciepło-Poświata"

#: ../../reference_manual/blending_modes/quadratic.rst:112
msgid "This blending mode is called \"Heat-Glow\" in English."
msgstr "Ten tryb mieszania po angielsku nazywa się \"Heat-Glow\"."

#: ../../reference_manual/blending_modes/quadratic.rst:114
msgid "Mix of Heat, and Glow blending modes."
msgstr "Mieszanina trybów mieszania ciepła i poświaty."

#: ../../reference_manual/blending_modes/quadratic.rst:119
msgid ""
".. image:: images/blending_modes/quadratic/"
