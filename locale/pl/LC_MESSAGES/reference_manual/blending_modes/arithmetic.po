msgstr "Po lewej: **Normalnie**. Po prawej: **Odwrotne odejmowanie**."

#: ../../reference_manual/blending_modes/arithmetic.rst:110
msgid ""
"Orange(1, 0.5961, 0.0706)_(1_Light Blue(0.1608, 0.6274, 0.8274)) = (0.1608, "
"0.2235, -0.102) → Dark Green(0.1608, 0.2235, 0)"
msgstr ""
"Pomarańczowy(1, 0.5961, 0.0706)_(1_Jasny niebieski(0.1608, 0.6274, 0.8274)) "
"= (0.1608, 0.2235, -0.102) → Ciemny zielony(0.1608, 0.2235, 0)"

