#: ../../reference_manual/blending_modes/arithmetic.rst:125
msgid "Multiply"
msgstr "Mnożenie"

#: ../../reference_manual/blending_modes/arithmetic.rst:129
msgid "This blending mode is called \"Multiply\" in English."
msgstr ""

#: ../../reference_manual/blending_modes/arithmetic.rst:131
msgid ""
"Multiplies the two colors with each other, but does not go beyond the upper "
"limit."
msgstr ""
"Mnoży dwie barwy przez siebie, lecz nie wzrasta powyżej ustawionej górnej "
"granicy."

#: ../../reference_manual/blending_modes/arithmetic.rst:133
msgid ""
"This is often used to color in a black and white lineart. One puts the black "
"and white lineart on top, sets the layer to 'Multiply', and then draws in "
"color on a layer beneath. Multiply will allow all the color to go through."
msgstr ""
"Jest to często używane do kolorowania czarno-białego obrazu. Umieszcza się "
"obraz czarno-biały na szczycie, ustawia warstwę na 'Mnożenie', a następnie "
"maluje barwami na warstwie poniżej. Mnożenie umożliwi wszystkim barwom na "
"przebicie się."

#: ../../reference_manual/blending_modes/arithmetic.rst:136
msgid "White(1,1,1) x White(1, 1, 1) = White(1, 1, 1)"
msgstr "Biały(1,1,1) x Biały(1, 1, 1) = Biały(1, 1, 1)"

#: ../../reference_manual/blending_modes/arithmetic.rst:138
msgid "White(1, 1, 1) x Gray(0.5, 0.5, 0.5) = Gray(0.5, 0.5, 0.5)"
msgstr "Biały(1, 1, 1) x Szary(0.5, 0.5, 0.5) = Szary(0.5, 0.5, 0.5)"

#: ../../reference_manual/blending_modes/arithmetic.rst:140
msgid ""
"Darker Gray(0.4, 0.4, 0.4) x Lighter Gray(0.5, 0.5, 0.5) = Even Darker Gray "
"(0.2, 0.2, 0.2)"
msgstr ""
"Ciemniejszy Szary(0.4, 0.4, 0.4) x Jaśniejszy Szary(0.5, 0.5, 0.5) = Even "
"Ciemniejszy Szary (0.2, 0.2, 0.2)"

