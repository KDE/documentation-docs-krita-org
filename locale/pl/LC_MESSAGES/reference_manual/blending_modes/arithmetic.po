msgid "Red(1, 0, 0) + Gray(0.5, 0.5, 0.5) = Pink(1, 0.5, 0.5)"
msgstr "Czerwony(1, 0, 0) + Szary(0.5, 0.5, 0.5) = Różowy(1, 0.5, 0.5)"

