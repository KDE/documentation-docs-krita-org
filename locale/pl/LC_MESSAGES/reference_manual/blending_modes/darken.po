msgstr "Po lewej: **Normalny**. Po prawej: **Wypalanie**."

#: ../../reference_manual/blending_modes/darken.rst:37
msgid ""
"1_{[1_Light Blue(0.1608, 0.6274, 0.8274)] / Orange(1, 0.5961, 0.0706)} = "
"(0.1608, 0.3749, -1.4448) → Green(0.1608, 0.3749, 0)"
msgstr ""
"1_{[1_Jasny niebieski(0.1608, 0.6274, 0.8274)] / Pomarańczowy(1, 0.5961, "
"0.0706)} = (0.1608, 0.3749, -1.4448) → Zielony(0.1608, 0.3749, 0)"

