#: ../../reference_manual/blending_modes/darken.rst:164
#: ../../reference_manual/blending_modes/darken.rst:168
msgid "Linear Burn"
msgstr "Liniowe wypalanie"

#: ../../reference_manual/blending_modes/darken.rst:172
msgid "This blending mode is called \"Linear Burn\" in English."
msgstr "Ten tryb mieszania po angielsku nazywa się \"Linear Burn\"."

#: ../../reference_manual/blending_modes/darken.rst:174
msgid ""
"Adds the values of the two layers together and then subtracts 1. Seems to "
"produce the same result as :ref:`bm_inverse_subtract`."
msgstr ""
"Dodaje wartości dwóch warstw do siebie, a następnie odejmuje 1. Wygląda "
"jakby dawał ten sam wynik co :ref:`bm_inverse_subtract`."

#: ../../reference_manual/blending_modes/darken.rst:176
msgid ""
"[Darker Gray(0.4, 0.4, 0.4) + Lighter Gray(0.5, 0.5, 0.5)]_1 = (-0.1000, "
"-0.1000, -0.1000)  → Black(0, 0, 0)"
msgstr ""
"[Ciemniejszy szary(0.4, 0.4, 0.4) + Jaśniejszy szary(0.5, 0.5, 0.5)]_1 = "
"(-0.1000, -0.1000, -0.1000)  → Czarny(0, 0, 0)"

