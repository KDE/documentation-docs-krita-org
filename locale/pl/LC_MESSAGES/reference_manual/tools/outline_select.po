#: ../../reference_manual/tools/outline_select.rst:14
msgid "Selection"
msgstr "Zaznaczenie"

#: ../../reference_manual/tools/outline_select.rst:14
msgid "Freehand"
msgstr "Odręczna ścieżka"

#: ../../reference_manual/tools/outline_select.rst:14
