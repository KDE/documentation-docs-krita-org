msgstr "Rysuje czarny wielokąt jako muśnięcie."

#: ../../reference_manual/brushes/brush_engines/dyna_brush_engine.rst:65
msgid "Wire"
msgstr "Pręt"

#: ../../reference_manual/brushes/brush_engines/dyna_brush_engine.rst:66
