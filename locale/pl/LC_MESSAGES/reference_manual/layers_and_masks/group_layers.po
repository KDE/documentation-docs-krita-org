msgstr "Jak używać grupowania warstw w Kricie."

#: ../../reference_manual/layers_and_masks/group_layers.rst:12
msgid "Layers"
msgstr "Warstwy"

#: ../../reference_manual/layers_and_masks/group_layers.rst:12
msgid "Groups"
msgstr "Grupy"

#: ../../reference_manual/layers_and_masks/group_layers.rst:12
