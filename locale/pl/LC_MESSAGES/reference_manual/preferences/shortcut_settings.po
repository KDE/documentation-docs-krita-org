#: ../../reference_manual/preferences/shortcut_settings.rst:1
msgid "Configuring shortcuts in Krita."
msgstr "Ustawienia skrótów w Kricie."

#: ../../reference_manual/preferences/shortcut_settings.rst:11
msgid "Preferences"
msgstr "Ustawienia"

#: ../../reference_manual/preferences/shortcut_settings.rst:11
