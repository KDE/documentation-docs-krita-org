"Sets where the SQLite Database that manages all the resources is located."
msgstr ""
"Ustawia położenie bazy danych SQLite, która zarządza wszystkimi zasobami."

#: ../../reference_manual/preferences/general_settings.rst:378
msgid "Sets where the Resource Folder itself is located."
msgstr "Ustawia położenie katalogu zasobów."

