#| msgid ".. image:: images/animation/import_video.png"
msgid ".. image:: /images/animation/import_video.png"
msgstr ".. image:: images/animation/import_video.png"

#: ../../reference_manual/import_animation.rst:82
msgid "Choose a video file"
msgstr "Wybierz plik filmu"

#: ../../reference_manual/import_animation.rst:83
msgid ""
"This will bring up a file chooser for you to select the file in question."
msgstr "Przywoła to okno wyboru plików, aby móc wybrać dany plik."

#: ../../reference_manual/import_animation.rst:84
msgid "Preview"
msgstr "Podgląd"

#: ../../reference_manual/import_animation.rst:85
msgid "Gives a preview of the file to import."
msgstr "Daje podgląd importowanego pliku."

#: ../../reference_manual/import_animation.rst:86
msgid "Slider"
msgstr "Suwak"

#: ../../reference_manual/import_animation.rst:87
msgid "Allows you to scrub through the file in question."
msgstr "Umożliwia przewijanie na czasie trwania danego pliku."

#: ../../reference_manual/import_animation.rst:88
msgid "Frame Counter"
msgstr "Licznik klatek"

#: ../../reference_manual/import_animation.rst:89
msgid "Allows you to select the frame in question"
msgstr "Umożliwia wybranie klatki danego pliku"

#: ../../reference_manual/import_animation.rst:91
msgid "Frame Switcher"
msgstr "Przełącznik klatek"

#: ../../reference_manual/import_animation.rst:91
msgid "Two buttons to switch per frame."
msgstr "Dw przyciski do przełączania po klatkach."

#: ../../reference_manual/import_animation.rst:94
msgid "Video file info"
msgstr "Szczegóły pliku filmu"

#: ../../reference_manual/import_animation.rst:95
#: ../../reference_manual/import_animation.rst:134
#: ../../reference_manual/import_animation.rst:142
msgid "Width"
msgstr "Szerokość"

#: ../../reference_manual/import_animation.rst:96
msgid "The width of the current file."
msgstr "Szerokość bieżącego pliku."

#: ../../reference_manual/import_animation.rst:97
#: ../../reference_manual/import_animation.rst:137
#: ../../reference_manual/import_animation.rst:144
msgid "Height"
msgstr "Wysokość"

#: ../../reference_manual/import_animation.rst:98
msgid "The height of the current file."
msgstr "Wysokość bieżącego pliku."

#: ../../reference_manual/import_animation.rst:99
#: ../../reference_manual/import_animation.rst:120
msgid "Duration"
msgstr "Czas trwania"

#: ../../reference_manual/import_animation.rst:100
msgid "The duration in seconds."
msgstr "Czas trwania, w sekundach."

#: ../../reference_manual/import_animation.rst:101
msgid "Frames"
msgstr "Klatki"

#: ../../reference_manual/import_animation.rst:102
msgid "The total amount of frames"
msgstr "Całkowita liczba klatek"

#: ../../reference_manual/import_animation.rst:103
#: ../../reference_manual/import_animation.rst:114
msgid "FPS"
msgstr "kl/s"

#: ../../reference_manual/import_animation.rst:104
msgid "The frames per second."
msgstr "Liczba klatek na sekundę."

#: ../../reference_manual/import_animation.rst:105
msgid "Color Primaries"
msgstr "Główne barwy"

#: ../../reference_manual/import_animation.rst:106
msgid ""
"The name of the color space primaries Krita has detected. These will be used "
"for the color profile with which the file imports. Only shows up on files "
"where this data is detected."
msgstr ""
"Nazwa głównych barw przestrzeni barw, które wykryła Krita. Zostaną one użyte "
"do profilu barw, który jest importowany z pliku. Pokazuje się tylko dla tych "
"plików, dla których wykryto obecność tych danych."

#: ../../reference_manual/import_animation.rst:108
msgid ""
"The name of the color space trc that Krita has found. This too will be used "
"for the color profile. Only shows up on files where this data is detected."
msgstr ""
"Nazwa przestrzeni barw trc, które wykryła Krita. Zostanie ona także użyta do "
"profilu barw. Pokazuje się tylko dla tych plików, dla których wykryto "
"obecność tych danych."

#: ../../reference_manual/import_animation.rst:109
msgid "Color Transfer"
msgstr "Przeniesienie barwy"

#: ../../reference_manual/import_animation.rst:112
msgid "Import Options"
msgstr "Ustawienia importu"

#: ../../reference_manual/import_animation.rst:115
msgid ""
"The FPS to import at. Importing 2 seconds of footage at 24 fps will import "
"48 frames, and at 60 fps, 120 frames will be imported."
msgstr ""
"Liczba klatek na sekundę, przy której importować. Importowanie 2 sekundowego "
"materiału przy liczbie klatek 24 na sekundę zaimportuje 48 klatek, a przy 60 "
"klatkach na sekundę, zaimportuje 120."

#: ../../reference_manual/import_animation.rst:116
msgid "Skip Interval"
msgstr "Okres do pominięcia"

#: ../../reference_manual/import_animation.rst:117
msgid ""
"Same as :guilabel:`Step` in the :ref:`Import Frames<import_frames>` section."
msgstr ""
"To samo co :guilabel:`Krok` w obszarze :ref:`Importowanie "
"klatek<import_frames>`."

#: ../../reference_manual/import_animation.rst:119
msgid "Time code to start at."
msgstr "Kod czasowy, na którym rozpocząć."

#: ../../reference_manual/import_animation.rst:121
msgid "Length of the imported animation."
msgstr "Długość importowanej animacji."

#: ../../reference_manual/import_animation.rst:123
msgid "Import into"
msgstr "Zaimportuj do"

#: ../../reference_manual/import_animation.rst:123
msgid ""
"Document to import the file into. Options are current document and new "
"document. With new document, extra options become available on the second "
"tab."
msgstr ""
"Dokument, do którego zaimportować plik. Można wybrać bieżący lub nowy "
"dokument. W przypadku nowego dokumentu pojawią się dodatkowe ustawienia na "
"drugiej karcie."

#: ../../reference_manual/import_animation.rst:125
msgid ""
"Videos, because you usually only play them in a media player, are compressed "
"in special ways. Because Krita is designed to allow you to draw each "
"individual frame, this data gets uncompressed. What this means is that even "
"though you can watch a video file on your computer, you likely cannot import "
"all the frames into Krita. A warning will be displayed and inform you how "
"many frames you can import with your current setup."
msgstr ""
"Film są pakowane w sposób szczególny, bo odtwarzasz je zazwyczaj w "
"odtwarzaczu filmów. Ponieważ Krita została stworzona tak, aby umożliwiać "
"rysowanie każdej klatki, to dane te są pakowane. Oznacza to, że nawet gdy "
"możesz obejrzeć film na swoim komputerze, to nie możesz zaimportować "
"wszystkich klatek do Krity. Zostanie wyświetlone ostrzeżenie, mówiące o "
"liczbie klatek, które będzie można zaimportować przy obecnych ustawieniach."

#: ../../reference_manual/import_animation.rst:128
msgid "Options"
msgstr "Ustawienia"

#: ../../reference_manual/import_animation.rst:131
msgid "Document Options"
msgstr "Ustawienia dokumentu"

#: ../../reference_manual/import_animation.rst:132
msgid "Only enabled when the import is into a new document."
msgstr "Włączone tylko w przypadku importowania do nowego dokumentu."

#: ../../reference_manual/import_animation.rst:135
msgid "Width of the new document."
msgstr "Szerokość nowego dokumentu."

#: ../../reference_manual/import_animation.rst:137
msgid "Height of the new document."
msgstr "Wysokość nowego dokumentu."

#: ../../reference_manual/import_animation.rst:140
msgid "Import Video Scale"
msgstr "Zaimportuj skalę obrazu"

#: ../../reference_manual/import_animation.rst:143
msgid "The desired width in pixels"
msgstr "Żądana szerokość w pikselach"

#: ../../reference_manual/import_animation.rst:145
msgid "The desired height in pixels"
msgstr "Żądana wysokość w pikselach"

#: ../../reference_manual/import_animation.rst:147
msgid "The filter to use for the resizing."
msgstr "Filtr używany do zmiany rozmiaru."

#: ../../reference_manual/import_animation.rst:148
msgid "Filter"
msgstr "Filtr"

#: ../../reference_manual/import_animation.rst:151
msgid "FFMpeg"
msgstr "FFMpeg"

#: ../../reference_manual/import_animation.rst:153
msgid "FFMpeg Path"
msgstr "Ścieżka do FFMpeg"

#: ../../reference_manual/import_animation.rst:154
msgid "Path to the ffmpeg executable, necessary for importing the video data."
msgstr ""
"Ścieżka do pliku wykonywalnego ffmpeg, wymaganego do importowania danych "
"filmu."

#: ../../reference_manual/import_animation.rst:156
msgid "FFProbe path"
msgstr "Ścieżka do FFProbe"

#: ../../reference_manual/import_animation.rst:156
msgid ""
"Path to the ffmpeg probe executable, which is included with ffmpeg. This "
"allows Krita to learn the video information from the file."
msgstr ""
"Ścieżka do pliku wykonywalnego ffmpeg probe, który jest dostarczany z "
"ffmpeg. Umożliwia to Kricie pobranie szczegółów o filmie z jego pliku."

#: ../../reference_manual/import_animation.rst:160
msgid ""
