#: ../../reference_manual/sharing_krita_logs.rst:None
msgid ""
"# On Linux, if installed from repositories:\n"
"krita\n"
"# On Linux, in all other cases:\n"
"#  (remember that if you want to reference a file from the directory\n"
"#   you're currently in, you need to write: './krita_filename' instead of "
"'krita_filename'\n"
"#   and remember that this file need to have execution rights to be "
"executed)\n"
"path/to/krita\n"
"# On Mac:\n"
"/Applications/krita.app/Contents/MacOS/krita"
