#: ../../reference_manual/brushes/brush_engines/color_smudge_engine.rst:19
msgid "Color Smudge Brush Engine"
msgstr "颜色涂抹笔刷引擎"

#: ../../reference_manual/brushes/brush_engines/color_smudge_engine.rst:14
msgid "Brush Engine"
msgstr "笔刷引擎"

#: ../../reference_manual/brushes/brush_engines/color_smudge_engine.rst:14
msgid "Color Mixing"
msgstr "颜色混合"

