#: ../../reference_manual/dockers/touch_docker.rst:-1
msgid "Overview of the touch docker."
msgstr "介绍 Krita 的触摸屏辅助按钮面板。"

#: ../../reference_manual/dockers/touch_docker.rst:10
msgid "Touch"
msgstr "触摸"

#: ../../reference_manual/dockers/touch_docker.rst:10
msgid "Finger"
msgstr "手指"

#: ../../reference_manual/dockers/touch_docker.rst:10
msgid "Tablet UI"
msgstr "平板"

#: ../../reference_manual/dockers/touch_docker.rst:15
msgid "Touch Docker"
msgstr "触摸屏辅助按钮"

#: ../../reference_manual/dockers/touch_docker.rst:17
msgid ""
"The Touch Docker is a QML docker with several convenient actions on it. Its "
"purpose is to aid those who use Krita on a touch-enabled screen by providing "
"bigger gui elements."
msgstr ""
"此面板专门针对平板电脑等无键盘的触摸屏设备设计，为绘画时最常用的辅助操作准备"
"了便于触摸的大型按钮。"

#: ../../reference_manual/dockers/touch_docker.rst:19
msgid "Its actions are..."
msgstr "面板的可用操作及位置如下："

#: ../../reference_manual/dockers/touch_docker.rst:24
msgid "Open File"
msgstr "打开文件"

#: ../../reference_manual/dockers/touch_docker.rst:24
msgid "Save File"
msgstr "保存文件"

#: ../../reference_manual/dockers/touch_docker.rst:24
msgid "Save As..."
msgstr "另存为"

#: ../../reference_manual/dockers/touch_docker.rst:28
msgid "Undo"
msgstr "撤销"

#: ../../reference_manual/dockers/touch_docker.rst:28
msgid "Redo"
msgstr "重做"

#: ../../reference_manual/dockers/touch_docker.rst:32
msgid "Increase opacity"
msgstr "提高不透明度"

#: ../../reference_manual/dockers/touch_docker.rst:32
msgid "Make brush color lighter"
msgstr "提高笔刷颜色亮度"

#: ../../reference_manual/dockers/touch_docker.rst:36
msgid "Decrease opacity"
msgstr "降低不透明度"

#: ../../reference_manual/dockers/touch_docker.rst:36
msgid "Make brush color darker"
msgstr "降低笔刷颜色亮度"

#: ../../reference_manual/dockers/touch_docker.rst:40
msgid "Rotate Canvas Left by 15°"
msgstr "旋转画布 (向左 15°)"

#: ../../reference_manual/dockers/touch_docker.rst:40
msgid "Reset Canvas Rotation and Reset Zoom"
msgstr "重置画布旋转和缩放"

#: ../../reference_manual/dockers/touch_docker.rst:40
msgid "Rotate Canvas Right by 15°"
msgstr "旋转画布 (向右 15°)"

#: ../../reference_manual/dockers/touch_docker.rst:45
msgid "Increase Brush Size"
msgstr "增大笔刷尺寸"

#: ../../reference_manual/dockers/touch_docker.rst:45
msgid "Zoom in"
msgstr "放大"

#: ../../reference_manual/dockers/touch_docker.rst:49
msgid "Decrease Brush Size"
msgstr "减小笔刷尺寸"

#: ../../reference_manual/dockers/touch_docker.rst:49
msgid "Zoom out"
msgstr "缩小"

#: ../../reference_manual/dockers/touch_docker.rst:53
msgid "Switch to Previous Preset"
msgstr "切换到上一个预设"

#: ../../reference_manual/dockers/touch_docker.rst:57
msgid "Delete Layer Contents"
msgstr "清除图层内容"
