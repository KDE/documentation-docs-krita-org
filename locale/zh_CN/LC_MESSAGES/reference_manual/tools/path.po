#: ../../reference_manual/tools/path.rst:1
msgid "Krita's path tool reference."
msgstr "Krita的路径工具参考。"

#: ../../reference_manual/tools/path.rst:11
msgid "Tools"
msgstr "工具"

#: ../../reference_manual/tools/path.rst:11
