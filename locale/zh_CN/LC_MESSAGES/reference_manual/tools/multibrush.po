msgstr "工具"

#: ../../reference_manual/tools/multibrush.rst:11
msgid "Multibrush"
msgstr "多路笔刷"

#: ../../reference_manual/tools/multibrush.rst:11
msgid "Mandala"
msgstr "万花筒"

#: ../../reference_manual/tools/multibrush.rst:11
