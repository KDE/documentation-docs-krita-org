msgid "Tools"
msgstr "工具"

#: ../../reference_manual/tools/multibrush.rst:11
msgid "Multibrush"
msgstr "多笔刷"

#: ../../reference_manual/tools/multibrush.rst:11
msgid "Mandala"
msgstr "曼达拉"

#: ../../reference_manual/tools/multibrush.rst:11
