"1_{[1_Light Blue(0.1608, 0.6274, 0.8274)] / Orange(1, 0.5961, 0.0706)} = "
"(0.1608, 0.3749, -1.4448) → Green(0.1608, 0.3749, 0)"
msgstr ""
"1 - {[1 - 浅蓝 (0.1608, 0.6274, 0.8274)] / 橙 (1, 0.5961, 0.0706)} = "
"(0.1608, 0.3749, -1.4448) → 最小值为 0 → 绿 (0.1608, 0.3749, 0)"

