#: ../../reference_manual/blending_modes/binary.rst:200
#: ../../reference_manual/blending_modes/binary.rst:204
msgid "XOR"
msgstr "XOR - 异或"

#: ../../reference_manual/blending_modes/binary.rst:208
msgid "This blending mode is called \"XOR\" in English."
msgstr "此混合模式的英文名为“XOR”。"

#: ../../reference_manual/blending_modes/binary.rst:210
msgid ""
"Performs the XOR operation for base and blend layer. This mode has a special "
"property that if you duplicate the blend layer twice, you get the base layer."
msgstr ""
"对基底图层和混合图层进行逻辑异或 (XOR) 运算。如果把处于此模式的混合图层复制两"
"次副本，还会得到原来的基底图层。"

