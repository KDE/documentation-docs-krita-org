msgid "Freeze-Reflect"
msgstr "冷却-反射"

#: ../../reference_manual/blending_modes/quadratic.rst:47
msgid "This blending mode is called \"Freeze-Reflect\" in English."
msgstr "此混合模式的英文名为“Freeze-Reflect”。"

#: ../../reference_manual/blending_modes/quadratic.rst:49
msgid "Mix of Freeze and Reflect blending modes."
msgstr "将冷却模式和反射模式结合运用。"

