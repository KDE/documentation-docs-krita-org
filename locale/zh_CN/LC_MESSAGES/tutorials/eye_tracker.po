#: ../../tutorials/eye_tracker.rst:1
msgid "Setting up Krita to use with an eye tracker. "
msgstr "介绍如何通过眼动仪使用 Krita。 "

#: ../../tutorials/eye_tracker.rst:1
msgid "- H. Turgut Uyar <hturgut@uyar.info> "
msgstr "- H. Turgut Uyar <hturgut@uyar.info> "

