#: ../../reference_manual/blending_modes/arithmetic.rst:191
msgid "Left: **Normal**. Right: **Subtract**."
msgstr "Sol: **Normal**. Sağ: **Çıkarma**."

#: ../../reference_manual/blending_modes/arithmetic.rst:181
msgid ""
"Light Blue(0.1608, 0.6274, 0.8274) - Orange(1, 0.5961, 0.0706) = (-0.8392, "
"0.0313, 0.7568) → Blue(0, 0.0313, 0.7568)"
msgstr ""
"Açık Mavi(0,1608; 0,6274; 0,8274) − Turuncu(1; 0,5961; 0,0706) = (−0,8392; "
"0,0313; 0,7568) → Mavi(0; 0,0313; 0,7568)"

