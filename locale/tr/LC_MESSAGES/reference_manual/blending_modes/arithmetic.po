#: ../../reference_manual/blending_modes/arithmetic.rst:78
#: ../../reference_manual/blending_modes/arithmetic.rst:85
#: ../../reference_manual/blending_modes/arithmetic.rst:90
msgid "Left: **Normal**. Right: **Divide**."
msgstr "Sol: **Normal**. Sağ: **Bölme**."

#: ../../reference_manual/blending_modes/arithmetic.rst:80
msgid ""
"Light Blue(0.1608, 0.6274, 0.8274) / Orange(1, 0.5961, 0.0706) = (0.1608, "
"1.0525, 11.7195) → Aqua(0.1608, 1, 1)"
msgstr ""
"Açık Mavi(0,1608; 0,6274; 0,8274) / Turuncu(1; 0,5961; 0,0706) = (0,1608; "
"1,0525; 11,7195) → Camgöbeği(0,1608; 1; 1)"

