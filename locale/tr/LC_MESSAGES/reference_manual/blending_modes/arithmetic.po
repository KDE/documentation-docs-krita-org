#: ../../reference_manual/blending_modes/arithmetic.rst:63
msgid "Divide"
msgstr "Bölme"

#: ../../reference_manual/blending_modes/arithmetic.rst:67
msgid "This blending mode is called \"Divide\" in English."
msgstr "Bu harmanlama kipine Türkçede “Bölme” denir."

#: ../../reference_manual/blending_modes/arithmetic.rst:69
msgid "Divides the numerical value from the lower color by the upper color."
msgstr "Alt renkten gelen sayısal değeri üst renge böler."

#: ../../reference_manual/blending_modes/arithmetic.rst:71
msgid "Red(1, 0, 0) / Gray(0.5, 0.5, 0.5) = (2, 0, 0) → Red(1, 0, 0)"
msgstr "Kırmızı(1; 0; 0) / Gri(0,5; 0,5; 0,5) = (2; 0; 0) → Red(1; 0; 0)"

#: ../../reference_manual/blending_modes/arithmetic.rst:73
msgid ""
"Darker Gray(0.4, 0.4, 0.4) / Lighter Gray(0.5, 0.5, 0.5) = Even Lighter Gray "
"(0.8, 0.8, 0.8)"
msgstr ""
"Koyu Gri(0,4; 0,4; 0,4) / Açık Gri(0,5; 0,5; 0,5) = Daha Açık Gri(0,8; 0,8; "
"0,8)"

#: ../../reference_manual/blending_modes/arithmetic.rst:78
msgid ""
".. image:: /images/blending_modes/arithmetic/"
