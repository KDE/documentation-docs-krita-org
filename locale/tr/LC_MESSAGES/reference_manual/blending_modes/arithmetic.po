#: ../../reference_manual/blending_modes/arithmetic.rst:152
#: ../../reference_manual/blending_modes/arithmetic.rst:157
msgid "Left: **Normal**. Right: **Multiply**."
msgstr "Sol: **Normal**. Sağ: **Çarpma**."

#: ../../reference_manual/blending_modes/arithmetic.rst:147
msgid ""
"Light Blue(0.1608, 0.6274, 0.8274) x Orange(1, 0.5961, 0.0706) = "
"Green(0.1608, 0.3740, 0.0584)"
msgstr ""
"Açık Mavi(0,1608; 0,6274; 0,8274) × Turuncu(1; 0,5961; 0,0706) = "
"Yeşil(0,1608; 0,3740; 0,0584)"

