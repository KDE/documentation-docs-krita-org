#: ../../reference_manual/blending_modes/arithmetic.rst:95
msgid "Inverse Subtract"
msgstr "Ters Çıkarma"

#: ../../reference_manual/blending_modes/arithmetic.rst:99
msgid "This blending mode is called \"Inverse Subtract\" in English."
msgstr "Bu harmanlama kipine Türkçede “Ters Çıkarma” denir."

#: ../../reference_manual/blending_modes/arithmetic.rst:101
msgid ""
"This inverts the lower layer before subtracting it from the upper layer."
msgstr "Bu, üst katmandan çıkarılmadan önce alt katmanı ters çevirir."

#: ../../reference_manual/blending_modes/arithmetic.rst:103
msgid ""
"Lighter Gray(0.5, 0.5, 0.5)_(1_Darker Gray(0.4, 0.4, 0.4)) = (-0.1, -0.1, "
"-0.1) → Black(0, 0, 0)"
msgstr ""
"Açık Gri(0,5; 0,5; 0,5) − (1 − Koyu Gri(0,4; 0,4; 0,4)) = (−0,1; −0,1; −0,1) "
"→ Siyah(0; 0; 0)"

#: ../../reference_manual/blending_modes/arithmetic.rst:108
msgid ""
".. image:: /images/blending_modes/arithmetic/"
"Blending_modes_Inverse_Subtract_Gray_0.4_and_Gray_0.5_n.png"
msgstr ""
".. image:: /images/blending_modes/arithmetic/"
"Blending_modes_Inverse_Subtract_Gray_0.4_and_Gray_0.5_n.png"

#: ../../reference_manual/blending_modes/arithmetic.rst:108
#: ../../reference_manual/blending_modes/arithmetic.rst:115
#: ../../reference_manual/blending_modes/arithmetic.rst:120
msgid "Left: **Normal**. Right: **Inverse Subtract**."
msgstr "Sol: **Normal**. Sağ: **Ters Çıkarma**."

#: ../../reference_manual/blending_modes/arithmetic.rst:110
msgid ""
"Orange(1, 0.5961, 0.0706)_(1_Light Blue(0.1608, 0.6274, 0.8274)) = (0.1608, "
"0.2235, -0.102) → Dark Green(0.1608, 0.2235, 0)"
msgstr ""
"Turuncu(1; 0,5961; 0,0706) − (1 − Açık Mavi(0,1608; 0,6274; 0,8274)) = "
"(0,1608; 0,2235; −0,102) → Koyu Yeşil(0,1608; 0,2235; 0)"

