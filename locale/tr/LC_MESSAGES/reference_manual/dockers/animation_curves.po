msgstr "Canlandırma Eğrileri paneline genel bir bakış."

#: ../../reference_manual/dockers/animation_curves.rst:11
msgid "Animation"
msgstr "Canlandırma"

#: ../../reference_manual/dockers/animation_curves.rst:11
msgid "Animation Curves"
msgstr "Canlandırma Eğrileri"

#: ../../reference_manual/dockers/animation_curves.rst:11
