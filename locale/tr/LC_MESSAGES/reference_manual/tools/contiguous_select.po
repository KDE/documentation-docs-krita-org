#: ../../reference_manual/tools/contiguous_select.rst:11
msgid "Selection"
msgstr "Seçim"

#: ../../reference_manual/tools/contiguous_select.rst:11
msgid "Contiguous Selection"
msgstr "Komşu Seçim"

#: ../../reference_manual/tools/contiguous_select.rst:11
msgid "Magic Wand"
msgstr "Sihirli Değnek"

#: ../../reference_manual/tools/contiguous_select.rst:11
msgid "Tools"
msgstr "Araçlar"

#: ../../reference_manual/tools/contiguous_select.rst:16
msgid "Contiguous Selection Tool"
msgstr "Komşu Seçim Aracı"

#: ../../reference_manual/tools/contiguous_select.rst:18
msgid "|toolselectcontiguous|"
msgstr "|toolselectcontiguous|"

#: ../../reference_manual/tools/contiguous_select.rst:20
msgid ""
"This tool, represented by a magic wand, allows you to make :ref:"
"`selections_basics` by selecting a point of color. It will select any "
"contiguous areas of a similar color to the one you selected. You can adjust "
"the \"fuzziness\" of the tool in the tool options dock. A lower number will "
"select colors closer to the color that you chose in the first place."
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:23
msgid "Hotkeys and Sticky keys"
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:25
msgid ""
":kbd:`Shift +` |mouseleft| sets the subsequent selection to 'add'. You can "
"release the :kbd:`Shift` key while dragging, but it will still be set to "
"'add'. Same for the others."
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:26
msgid ":kbd:`Alt +` |mouseleft| sets the subsequent selection to 'subtract'."
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:27
msgid ":kbd:`Ctrl +` |mouseleft| sets the subsequent selection to 'replace'."
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:28
msgid ""
":kbd:`Shift + Alt +` |mouseleft| sets the subsequent selection to "
"'intersect'."
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:32
msgid "Hovering over a selection allows you to move it."
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:33
msgid ""
"|mouseright| will open up a selection quick menu with amongst others the "
"ability to edit the selection."
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:37
msgid ""
"You can switch the behavior of the :kbd:`Alt` key to use the :kbd:`Ctrl` key "
"instead by toggling the switch in the :ref:`general_settings`."
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:40
msgid "Tool Options"
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:44
msgid "Threshold"
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:44
msgid ""
"This controls whether or not the contiguous selection sees another color as "
"a border."
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:48
msgid "Selection Extent"
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:48
msgid "Spread"
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:49
msgid ""
"Set how far the fully opaque portion of the selection should extend. See :"
"ref:`fill_tool` for extra explanation."
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:51
msgid "Anti-alias"
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:52
msgid ""
"This will smooth the jagged edges present in the selection. It differs from "
"feathering in that this will smooth in the direction of the edge instead of "
"all directions, and only if the edge is jagged (high contrast)."
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:53
msgid "Grow Selection"
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:54
msgid ""
"This value extends (positive values) or contracts (negative values) the "
"selection."
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:55
msgid "Adjustments"
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:55
msgid "Feathering Radius"
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:56
msgid "This value will add a soft border to the selection."
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:60
msgid ""
"Select which layers to use as a reference for the contiguous select tool. "
"The options are:"
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:62
msgid "Current Layer"
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:63
msgid "Only use the currently selected layer."
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:64
msgid "All layers"
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:65
msgid "Use all visible layers."
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:67
msgid ""
"Use only the layers specified with a certain color label. This is useful for "
"complex images, where you might have multiple lineart layers. Label them "
"with the appropriate color label and use these labels to mark which layers "
"to use as a reference."
msgstr ""

#: ../../reference_manual/tools/contiguous_select.rst:70
msgid "Select the color labels of the layers that should be used as reference."
msgstr ""

